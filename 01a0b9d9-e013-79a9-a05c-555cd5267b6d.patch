+() => {
+ const EPS=1e-6;
+    for(const name of ['box','round']){const original=PropMeshBuilder.prototype[name];PropMeshBuilder.prototype[name]=function(...args){const start=this.p.length/3,ix=this.idx.length;original.apply(this,args);(this.auditRanges||(this.auditRanges=[])).push({kind:name,start,count:this.p.length/3-start,ix,countIx:this.idx.length-ix});};}
+   const geom=PropMeshBuilder.prototype.geometry;PropMeshBuilder.prototype.geometry=function(...args){const g=geom.apply(this,args);g.userData.auditRanges=this.auditRanges||[];return g;};
+
+ startGame(true);closeDlg();G.paused=true;G.time=20;
+ enterScene('outdoor',SCENES.outdoor.spawn,{silent:true});update3D(.016);
+    function hull(mesh,range){
+    const g=mesh.geometry,P=g.attributes.position,ix=g.index,vertices=[],normals=[],edges=[],planes=[],box=new THREE.Box3();
+    const first=range?range.start:0,count=range?range.count:P.count;
+    for(let i=first;i<first+count;i++){const p=new THREE.Vector3().fromBufferAttribute(P,i).applyMatrix4(mesh.matrixWorld);vertices.push(p);box.expandByPoint(p);}
+    const pushUnique=(a,v)=>{if(v.lengthSq()<EPS*EPS)return;v.normalize();if(!a.some(n=>Math.abs(n.dot(v))>1-1e-6))a.push(v);};
+    const beg=range?range.ix:0,end=beg+(range?range.countIx:(ix?ix.count:P.count));
+    const triangles=[];
+    for(let i=beg;i<end;i+=3){const v=[0,1,2].map(k=>new THREE.Vector3().fromBufferAttribute(P,ix?ix.getX(i+k):i+k).applyMatrix4(mesh.matrixWorld));triangles.push(v);
+     const n=v[1].clone().sub(v[0]).cross(v[2].clone().sub(v[0])).normalize();if(n.lengthSq()<.5)continue;
+     pushUnique(normals,n.clone());const d=n.dot(v[0]);if(!planes.some(p=>p.n.dot(n)>1-1e-6&&Math.abs(p.d-d)<EPS))planes.push({n,d});
+     for(let k=0;k<3;k++)pushUnique(edges,v[(k+1)%3].clone().sub(v[k]));
+    }
+    return {vertices,normals,edges,planes,box,triangles};
+   }
+   function overlap(a,b){
+    const size=a.box.clone().intersect(b.box).getSize(new THREE.Vector3());if(Math.min(size.x,size.y,size.z)<=EPS)return null;
+    let depth=Infinity;
+    const axes=[...a.normals,...b.normals];for(const x of a.edges)for(const y of b.edges){const n=x.clone().cross(y);if(n.lengthSq()>EPS*EPS)axes.push(n.normalize());}
+    for(const n of axes){let amin=Infinity,amax=-Infinity,bmin=Infinity,bmax=-Infinity;for(const v of a.vertices){const t=v.dot(n);amin=Math.min(amin,t);amax=Math.max(amax,t);}for(const v of b.vertices){const t=v.dot(n);bmin=Math.min(bmin,t);bmax=Math.max(bmax,t);}const d=Math.min(amax,bmax)-Math.max(amin,bmin);if(d<=EPS)return null;depth=Math.min(depth,d);}
+    return {minimumAxisOverlap:depth,boundingOverlap:size.toArray()};
+   }
+
+ const find=(type,x,y)=>E3.sprites.find(p=>p.sp.type===type&&p.sp.x===x&&p.sp.y===y);
+ const t=find('transformer',93.2,64),l=find('lamp',92.5,64.5),w=find('lamp',30.5,50.5);
+ const parts=p=>{const m=p.o.children[0];return m.geometry.userData.auditRanges.map(r=>hull(m,r));};
+ const transformer=hull(t.o.children[0]),lp=parts(l),wp=parts(w),wbox=new THREE.Box3().setFromObject(w.o);
+ const contacts=lp.map((h,i)=>({component:i,hit:overlap(h,transformer)})).filter(r=>r.hit);
+ const baseIntersection=lp[0].box.clone().intersect(transformer.box).getSize(new THREE.Vector3());
+ const baseVolume=Math.max(0,baseIntersection.x)*Math.max(0,baseIntersection.y)*Math.max(0,baseIntersection.z);
+ const info={transformer:{baseOverlap:baseIntersection.toArray(),baseVolume,contacts,root:l.o.position.toArray(),meshOffset:l.o.children[0].position.toArray()},wheel:{root:w.o.position.toArray(),meshOffset:w.o.children[0].position.toArray(),lampZ:[wbox.min.z,wbox.max.z]}};
+ let maxCabZ=-Infinity,minCabZ=Infinity,positivePairs=0,sampledMinZGap=Infinity,samples=0,firstPositive=null;
+ // Geometry rotations only in this diagnostic page; same Z-axis rim/roll motion
+ // as production. Independent sway extrema also cover all time/phase combinations.
+ for(let i=0;i<=720;i++){
+  const theta=i*Math.PI/360;E3.wheel.rim.rotation.z=theta;
+  for(const roll of [-.05,0,.05]){
+   for(const gd of E3.wheelGondolas)gd.o.rotation.z=-theta+roll;
+   E3.world.updateMatrixWorld(true);
+   for(let j=0;j<E3.wheelGondolas.length;j++){
+    const cab=hull(E3.wheelGondolas[j].o);samples++;maxCabZ=Math.max(maxCabZ,cab.box.max.z);minCabZ=Math.min(minCabZ,cab.box.min.z);
+    sampledMinZGap=Math.min(sampledMinZGap,wbox.min.z-cab.box.max.z);
+    for(let k=0;k<wp.length;k++){const hit=overlap(wp[k],cab);if(hit){positivePairs++;if(!firstPositive)firstPositive={degrees:i*.5,roll,gondola:j,component:k,...hit};}}
+   }
+  }
+ }
+ const wheelRoot=E3.wheel.rim.parent;
+ const exactGondolaZHalfExtent=1.05/2;
+ const analyticalCabMaxZ=wheelRoot.position.z+exactGondolaZHalfExtent;
+ const analyticalMinimumClearance=wbox.min.z-analyticalCabMaxZ;
+ Object.assign(info.wheel,{phases:721,swayValues:[-.05,0,.05],gondolas:16,samples,positivePairs,firstPositive,sampledGondolaZ:[minCabZ,maxCabZ],sampledMinZGap,analyticalCabMaxZ,analyticalMinimumClearance,proof:'Wheel root yaw=0; rim and gondola rotations are around Z only; vertex world Z is invariant for every rim phase and sway angle.',rotation:wheelRoot.rotation.toArray(),requiredMinimumClearance:0});
+ return info;
+} 
