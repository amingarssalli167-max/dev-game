+ await exit('outdoor');await interact('od_b_school','school');await interact('doc_blockc');
+ check('School revisit / wave symbol',await page.evaluate(()=>G.syms.includes('wave')&&G.scene.shifted.blockC));
+ await exit('outdoor');await interact('od_b_kind','kindergarten');await interact('kin_musicbox');
+ check('Kindergarten zero symbol',await page.evaluate(()=>G.syms.includes('zero')));await exit('outdoor');
+ await interact('od_sub','substation');await interact('sub_panel');
+ check('Code UI opened',await page.evaluate(()=>CODE.open));
+ for(const i of [1,0,2])await page.click('#codePick .pick:nth-child('+(i+1)+')');await sleep(500);
+ check('Power puzzle accepted',await page.evaluate(()=>G.flags.power&&!CODE.open));
+ await interact('sub_locker');check('Keycard and tape reward',await page.evaluate(()=>hasItem('keycard')&&hasItem('tape2')));await exit('outdoor');
+ await interact('od_b_hosp','hospital');for(const id of ['doc_patient','doc_maternity'])await interact(id);
+ await interact('hosp_base_door','basement');await interact('doc_echo1');await interact('base_stairs','tunnels');
+ await interact('it_archkey');await interact('doc_obs');await interact('tun_arch','blacksite');
+ for(const id of ['doc_echo2','doc_zero1','bs_tape3'])await interact(id);
+ await page.evaluate(()=>auditDismiss());
+ const allScenes=await page.evaluate(()=>({visits:G.visits,syms:G.syms,items:Object.keys(G.items)}));
+ check('Part 1 clues / all four symbols',allScenes.syms.length===4,allScenes);
+ await page.keyboard.press('F5');const saved=await page.evaluate(()=>({scene:G.sceneId,x:G.player.x,y:G.player.y,docs:[...G.docs],syms:[...G.syms]}));
+ await page.reload({waitUntil:'domcontentloaded'});await page.click('#btnCont');await sleep(500);
+ check('Reload / Continue restores progress',await page.evaluate(s=>G.sceneId===s.scene&&Math.hypot(G.player.x-s.x,G.player.y-s.y)<.01&&JSON.stringify(G.docs)===JSON.stringify(s.docs)&&JSON.stringify(G.syms)===JSON.stringify(s.syms),saved));
+ // The helper functions live only in the previous page; final focus is nearby in this small room.
+ await page.evaluate(()=>{closeDoc();if(DLG.open)closeDlg();const c=G.scene.ints.find(i=>i.id==='bs_final');G.player.x=c.x;G.player.y=c.y+1;IN.aim=-Math.PI/2;updateHint();});
+ check('Final file focus',await page.evaluate(()=>curInt?.id==='bs_final'));
+ await page.keyboard.press('KeyE');await sleep(3900);
+ check('Ending reached from final interaction (not forced)',await page.evaluate(()=>G.flags.finalRead&&G.over&&$('endTitle').textContent==='STATUS: ORIGINAL'));
+ await page.screenshot({path:path.join(OUT,'original-ending.png')});
+ for(const kind of ['escape','deep','ask']){await page.evaluate(k=>epilogue(k),kind);const text=await page.$eval('#endBody pre',e=>e.textContent);check('Ending '+kind+' is complete',text.length>50,{length:text.length});}
+ // Finite transforms, geometry, references, and updates in every shipped scene.
+ const scenes=await page.evaluate(()=>{const out=[];G.over=false;closeDoc();closeDlg();$('end').classList.add('hide');for(const id of Object.keys(SCENES)){
+  enterScene(id,SCENES[id].spawn,{silent:true});for(let i=0;i<10;i++){updateEnts(.016);updateAnoms(.016);update3D(.016);}let finite=true,meshes=0;E3.scene.traverse(o=>{if(![o.position.x,o.position.y,o.position.z,...o.matrix.elements].every(Number.isFinite))finite=false;if(o.geometry){meshes++;for(const a of Object.values(o.geometry.attributes))if(!a.array.every(Number.isFinite))finite=false;}});
+  const missing=G.scene.ints.filter(i=>(i.doc&&!DOCS[i.doc])||(i.tape&&!TAPES[i.tape])||(i.to&&!SCENES[i.to])||!INTERACT.types[i.type]).map(i=>({id:i.id,doc:i.doc}));out.push({id,finite,meshes,refs:missing.length===0,missing});}return out;});
+ for(const s of scenes)check('Scene / references / finite geometry '+s.id,s.finite&&s.meshes>0&&s.refs,s);
