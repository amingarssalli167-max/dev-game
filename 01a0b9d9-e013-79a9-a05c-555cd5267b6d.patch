+  window.auditFocus=(id,openPassages=true)=>{auditDismiss();const s=G.scene,ox=G.player.x,oy=G.player.y;
+   const find=c=>{if(!c)return false;const q=auditReach();for(const i of q){const x=i%s.w+.5,y=Math.floor(i/s.w)+.5;if(Math.hypot(x-c.x,y-c.y)>INTERACT.range)continue;G.player.x=x;G.player.y=y;IN.aim=Math.atan2(c.y-y,c.x-x);updateHint();if(curInt===c||curInt?.id===c.id&&c.id)return true;G.player.x=ox;G.player.y=oy;}return false;};
+   for(let n=0;n<60;n++){const target=s.ints.find(i=>i.id===id);if(find(target))return {ok:true,x:G.player.x,y:G.player.y};if(!openPassages)break;let opened=false;for(const d of s.ints.filter(i=>i.type==='door'&&!i.to&&!i.used&&!i.locked)){if(find(d)){doInteract();opened=true;break;}}if(!opened)break;}
+   return {ok:false,id,scene:s.id,x:G.player.x,y:G.player.y};
+  };
+ });
+ async function interact(id,to){await page.evaluate(()=>auditDismiss());const r=await page.evaluate(id=>auditFocus(id),id);check('Reach / focus '+id,r.ok,r);if(!r.ok)throw Error('Route blocked at '+id);await page.keyboard.press('KeyE');if(to){await page.waitForFunction(to=>G.sceneId===to,{timeout:8000},to);await sleep(500);check('Scene link '+to,await page.evaluate(()=>!solidAt(G.scene,G.player.x,G.player.y,.30)));}else await sleep(80);}
