+// Serve a clearly labelled diagnostic candidate without editing the production file
+// or existing tests. This is the same source-interception technique as capture.js.
+const fs=require('fs'),p=require('puppeteer');
+const launch=p.launch.bind(p);
+const candidateLaunch=async (...args)=>{
+ const b=await launch(...args),newPage=b.newPage.bind(b);
+ b.newPage=async (...args)=>{
+  const page=await newPage(...args);await page.setRequestInterception(true);
+  page.on('request',r=>r.isNavigationRequest()?r.respond({status:200,contentType:'text/html',body:fs.readFileSync(process.env.CANDIDATE_SOURCE,'utf8')}):r.continue());return page;
+ };return b;
+};
+
+require.cache[require.resolve("puppeteer")].exports={...p,launch:candidateLaunch};
