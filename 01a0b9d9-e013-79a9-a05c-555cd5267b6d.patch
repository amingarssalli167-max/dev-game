+#!/usr/bin/env node
+// Fixed-view real WebGL measurements. This harness never modifies game files.
+// OUT=... NODE_PATH=... PUPPETEER_EXECUTABLE_PATH=... node capture.js
+const fs=require('fs'),path=require('path'),puppeteer=require('puppeteer');
+const OUT=process.env.OUT;if(!OUT)throw Error('OUT required');fs.mkdirSync(OUT,{recursive:true});
+(async()=>{
+ const browser=await puppeteer.launch({headless:true,args:[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']});
+ const errors=[],warnings=[],results=[];
+ try{
+  for(const view of [
+   {name:'street',scene:'outdoor',x:40.5,y:54.5,aim:-Math.PI/2,pitch:.12},
+   {name:'room',scene:'apartment',x:8.5,y:7.5,aim:-Math.PI/2,pitch:.12}
+  ]){
+   const page=await browser.newPage();await page.setViewport({width:960,height:540,deviceScaleFactor:1});
+   page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')errors.push(m.text());if(m.type()==='warn')warnings.push(m.text());});
+   page.on('requestfailed',r=>errors.push(r.url()+' '+r.failure()?.errorText));
+   await page.evaluateOnNewDocument(()=>{
+    // No simulation or adaptive-quality drift between captures. Camera code is original.
+    window.requestAnimationFrame=()=>0;
+    window.setTimeout=()=>0; // exclude delayed story spawns from static cost comparisons
+    let seed=19486;Math.random=()=>{seed=(Math.imul(1664525,seed)+1013904223)>>>0;return seed/4294967296;};
+   });
+   // Optional preserved source, served at the same origin with the same real Three library.
+   if(process.env.SOURCE){await page.setRequestInterception(true);page.on('request',r=>r.isNavigationRequest()?r.respond({status:200,contentType:'text/html',body:fs.readFileSync(process.env.SOURCE,'utf8')}):r.continue());}
+   await page.goto(process.env.BASE_URL||'http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+   await page.evaluate(v=>{
+    startGame(true);closeDlg();G.paused=true;G.time=20;G.dt=1/60;
+    enterScene(v.scene,{x:v.x,y:v.y},{silent:true});
+    IN.aim=v.aim;IN.lookX=IN.lookY=0;IN.movedByMouse=true;
+    E3.pitch=E3.pitchT=v.pitch;E3.camDist=CFG.camDistDefault;E3.camSnap=true;
+    G.player.bat=CFG.batMax;G.player.hidden=false;G.player.flash=true;
+    E3.quality=2;applyQuality();update3D(1/60);
+   },view);
+   for(const quality of [2,1,0])for(const flash of [true,false]){
+    const record=await page.evaluate(({quality,flash,view})=>{
+     E3.quality=quality;applyQuality();G.player.flash=flash;
+     for(let i=0;i<4;i++)update3D(1/60);
+     const R=E3.renderer,gl=R.getContext(),pixel=new Uint8Array(4),samples=[];
+     // CPU + synchronous GPU completion on software WebGL: not hardware FPS.
+     for(let i=0;i<15;i++){
+      const t=performance.now();update3D(1/60);gl.readPixels(0,0,1,1,gl.RGBA,gl.UNSIGNED_BYTE,pixel);samples.push(performance.now()-t);
+     }
+     samples.sort((a,b)=>a-b);
+     const lights=[];E3.scene.traverseVisible(o=>{if(o.isLight&&o.intensity>0)lights.push({type:o.type,intensity:o.intensity,color:o.color.getHex(),shadow:o.castShadow});});
+     const materials={};E3.scene.traverse(o=>{if(o.isMesh)for(const m of Array.isArray(o.material)?o.material:[o.material])materials[m.type]=(materials[m.type]||0)+1;});
+     const ground=new THREE.Vector3(G.player.x+Math.cos(IN.aim)*3,0.02,G.player.y+Math.sin(IN.aim)*3).project(E3.camera);
+     return {view,quality,flash,pixelRatio:R.getPixelRatio(),size:[R.domElement.width,R.domElement.height],
+      shadowEnabled:R.shadowMap.enabled,shadowMap:[E3.flash.shadow.mapSize.width,E3.flash.shadow.mapSize.height],
+      activeLights:lights.length,lights,render:{calls:R.info.render.calls,triangles:R.info.render.triangles},memory:{...R.info.memory},
+      synchronizedRenderMs:{median:samples[7],p95:samples[14],samples},materials,exposure:R.toneMappingExposure,
+      camera:{position:E3.camera.position.toArray(),quaternion:E3.camera.quaternion.toArray(),fov:E3.camera.fov},
+      floorProbe:[Math.round((ground.x*.5+.5)*960),Math.round((-.5*ground.y+.5)*540)],
+      collisionAtPlayer:solidAt(G.scene,G.player.x,G.player.y,.30),
+      gpu:gl.getParameter(gl.getExtension('WEBGL_debug_renderer_info').UNMASKED_RENDERER_WEBGL),
+      image:quality===2?R.domElement.toDataURL('image/png'):null};
+    },{quality,flash,view});
+    if(record.image){fs.writeFileSync(path.join(OUT,view.name+'-'+(flash?'on':'off')+'.png'),Buffer.from(record.image.split(',')[1],'base64'));delete record.image;}
+    results.push(record);console.log(view.name,quality,flash,JSON.stringify({calls:record.render.calls,triangles:record.render.triangles,memory:record.memory,lights:record.activeLights,ms:record.synchronizedRenderMs.median}));
+   }
+   await page.close();
+  }
+ }finally{await browser.close();fs.writeFileSync(path.join(OUT,'metrics.json'),JSON.stringify({results,errors,warnings},null,2));}
+ if(errors.length){console.error(errors);process.exitCode=1;}
+})().catch(e=>{console.error(e);process.exitCode=1;});
