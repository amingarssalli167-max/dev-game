+const fs=require('fs'),puppeteer=require('puppeteer');
+(async()=>{
+ const b=await puppeteer.launch({headless:true,args:[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']});const results=[],errors=[];
+ try{for(const [name,file] of [['unchanged-production','/home/user/.cache/lamp-repair/index.before.html'],['diagnostic-candidate','/home/user/.cache/lamp-repair/candidate.html']]){
+  const p=await b.newPage();p.on('pageerror',e=>errors.push(e.message));await p.evaluateOnNewDocument(()=>{requestAnimationFrame=()=>0;setTimeout=()=>0;});
+  await p.setRequestInterception(true);p.on('request',r=>r.isNavigationRequest()?r.respond({status:200,contentType:'text/html',body:fs.readFileSync(file,'utf8')}):r.continue());
+  await p.goto('http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+  const result=await p.evaluate('('+fs.readFileSync('step2-lamp-evidence/sweep-evaluate.js','utf8')+')()');results.push({name,...result});console.log(name,JSON.stringify(result));await p.close();
+ }}finally{await b.close();fs.writeFileSync('step2-lamp-evidence/sweep-results.json',JSON.stringify({results,errors},null,2));}
+})().catch(e=>{console.error(e);process.exitCode=1;});
