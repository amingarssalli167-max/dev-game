+// Additional placement verification; no existing test is edited or replaced.
+const fs=require('fs'),path=require('path'),puppeteer=require('puppeteer');
+(async()=>{
+ const out='step2-occlusion-evidence/placement';fs.mkdirSync(out,{recursive:true});
+ const browser=await puppeteer.launch({headless:true,args:[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']});
+ const results=[],errors=[],warnings=[];let data;
+ try{
+  const page=await browser.newPage();await page.setViewport({width:1280,height:720});
+  page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')errors.push(m.text());if(m.type()==='warn')warnings.push(m.text());});
+  await page.evaluateOnNewDocument(()=>{requestAnimationFrame=()=>0;setTimeout=()=>0;});
+  await page.goto('http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+  data=await page.evaluate(()=>{
+   startGame(true);closeDlg();G.paused=true;const records=[];
+   for(const id of ['slice','outdoor']){
+    enterScene(id,SCENES[id].spawn,{silent:true});E3.quality=2;applyQuality();update3D(.016);
+    const props=E3.sprites.filter(p=>p.o.userData.lowPoly),rc=new THREE.Raycaster();
+    for(const p of props){
+     const box=new THREE.Box3().setFromObject(p.o),o=p.o;
+     const height={car:.8,bus:1.2,sign:1.54,lamp:1.4,bench:.51,tree:.8,dead:.8,wreck:.6}[p.sp.type];
+     const target=new THREE.Vector3(o.position.x,height,o.position.z),sides=[];
+     if(id==='outdoor'&&p.sp.type==='lamp'&&
+       ((p.sp.x===92.5&&p.sp.y===64.5)||(p.sp.x===30.5&&p.sp.y===50.5))){
+      const meshWorld=o.children[0].getWorldPosition(new THREE.Vector3());
+      target.x=meshWorld.x;target.z=meshWorld.z;
+     }
+     for(const dir of [new THREE.Vector3(0,0,1),new THREE.Vector3(1,0,0),new THREE.Vector3(0,0,-1)]){
+      const origin=target.clone().addScaledVector(dir,10);rc.set(origin,dir.clone().negate());rc.far=20;
+      sides.push(rc.intersectObject(o,true).length>0);
+     }
+     let finite=true,newLights=0;const geometryIds=[];
+     o.traverse(m=>{if(m.isLight)newLights++;if(m.geometry){geometryIds.push(m.geometry.uuid);for(const a of Object.values(m.geometry.attributes))if(!a.array.every(Number.isFinite))finite=false;}});
+     records.push({scene:id,type:p.sp.type,x:p.sp.x,y:p.sp.y,anchor:o.position.toArray(),min:box.min.toArray(),max:box.max.toArray(),scale:o.scale.toArray(),geometryIds,finite,newLights,frontSideRear:sides});
+    }
+    const matrices=props.map(p=>p.o.matrixWorld.elements.slice());let fixed=true;
+    for(const a of [0,Math.PI/2,Math.PI,Math.PI*1.5]){IN.aim=a;E3.camSnap=true;update3D(.016);props.forEach((p,i)=>{if(p.o.matrixWorld.elements.some((v,k)=>v!==matrices[i][k]))fixed=false;});}
+    for(const r of records.filter(r=>r.scene===id))r.fixedDuringOrbit=fixed;
+   }
+   // Check actual solid component bounds, not whole-model broadphase bounds.
+   // Both components are axis-aligned boxes from the merged builder; therefore
+   // a positive overlap in all three axes is genuine solid interpenetration.
+   const sign=E3.sprites.find(p=>p.sp.type==='sign'&&p.sp.x===28&&p.sp.y===57.4);
+   const bench=E3.sprites.find(p=>p.sp.type==='bench'&&p.sp.x===29&&p.sp.y===57.4);
+   const component=(p,start)=>{const m=p.o.children[0],pos=m.geometry.attributes.position,b=new THREE.Box3();
+    for(let i=start;i<start+24;i++)b.expandByPoint(new THREE.Vector3().fromBufferAttribute(pos,i).applyMatrix4(m.matrixWorld));return b;};
+   const post=component(sign,24),slat=component(bench,24),intersection=post.clone().intersect(slat),size=intersection.getSize(new THREE.Vector3());
+   const volume=Math.max(0,size.x)*Math.max(0,size.y)*Math.max(0,size.z);
+   // Context image uses actual world positions/materials/lights; no added geometry.
+   G.player.x=32;G.player.y=60;IN.aim=Math.atan2(57.9-60,29.23-32);G.player.flash=true;E3.camSnap=true;update3D(.016);
+   const inspector=new THREE.PerspectiveCamera(40,1280/720,.05,80);inspector.position.set(31.5,1.4,60);inspector.lookAt(29.23,.65,57.9);
+   E3.renderer.render(E3.scene,inspector);
+   return {records,overlap:{sign:[28,57.4],bench:[29,57.4],post:{min:post.min.toArray(),max:post.max.toArray()},slat:{min:slat.min.toArray(),max:slat.max.toArray()},size:size.toArray(),volume,requiredMaximumVolume:0},image:E3.renderer.domElement.toDataURL('image/png')};
+  });
+  fs.writeFileSync(path.join(out,'sign-bench-intersection.png'),Buffer.from(data.image.split(',')[1],'base64'));delete data.image;
+  for(const r of data.records){
+   const pass=Math.abs(r.min[1])<1e-5&&r.finite&&r.newLights===0&&r.fixedDuringOrbit&&r.frontSideRear.every(Boolean)&&r.scale.every(x=>x===1)&&r.anchor[0]===r.x+.5&&r.anchor[2]===r.y+.5;
+   results.push({name:r.scene+' '+r.type+' '+r.x+','+r.y+' anchor/ground/orbit/front-side-rear/finite/no-light',pass});
+   if(!pass)break;
+  }
+  if(results.every(r=>r.pass))results.push({name:'Converted sign post does not intersect separate converted bench seat',pass:data.overlap.volume<=1e-9,detail:data.overlap});
+ }finally{await browser.close();}
+ fs.writeFileSync(path.join(out,'results.json'),JSON.stringify({results,data,errors,warnings},null,2));
+ for(const r of results)console.log((r.pass?'PASS ':'FAIL ')+r.name+(r.detail?' '+JSON.stringify(r.detail):''));
+ process.exitCode=results.some(r=>!r.pass)||errors.length?1:0;
+})().catch(e=>{console.error(e);process.exitCode=1;});
