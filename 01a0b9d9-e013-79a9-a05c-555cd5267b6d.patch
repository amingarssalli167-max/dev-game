++  const points=[[-w/2,-h/2,-d/2],[w/2,-h/2,-d/2],[w/2,-h/2,d/2],[-w/2,-h/2,d/2],
++    [-tx/2+ox,h/2,-tz/2],[tx/2+ox,h/2,-tz/2],[tx/2+ox,h/2,tz/2],[-tx/2+ox,h/2,tz/2]];
++  const cy=Math.cos(ry||0),sy=Math.sin(ry||0),cz=Math.cos(rz||0),sz=Math.sin(rz||0);
++  const v=points.map(p=>{const a=p[0]*cz-p[1]*sz,b=p[0]*sz+p[1]*cz;return [x+a*cy+p[2]*sy,y+b,z-a*sy+p[2]*cy];});
