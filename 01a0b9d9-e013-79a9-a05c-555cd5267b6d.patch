+/* Alex-only procedural skeletal adapter. ANIM remains the state machine;
+ * G.player remains the movement/collision authority. No root motion is applied.
+ * Stance targets are world-locked; a two-bone leg solve keeps the soles down. */
+(function () {
+  'use strict';
+  const V = THREE.Vector3, Q = THREE.Quaternion;
+  const UP = new V(0, 1, 0), DUTY = 0.56, TAU = Math.PI * 2;
+  const clamp = (n, a, b) => Math.max(a, Math.min(b, n));
+  const ease = t => t * t * (3 - 2 * t);
+  const follow = (a, b, dt, seconds) => a + (b - a) * (1 - Math.exp(-dt / seconds));
+
+  class AlexAnimator {
+    constructor(model, root) {
+      this.model = model;
+      this.bind = [];
+      this.bones = {};
+      model.traverse(o => {
+        if (o.isBone) {
+          this.bind.push({ bone: o, position: o.position.clone(), quaternion: o.quaternion.clone() });
+          this.bones[o.name.replace('mixamorig', '')] = o;
+        }
+        // One always-near player: avoid stale rest-pose culling bounds without
+        // reskinning 35k triangles on the CPU every frame to rebuild bounds.
+        if (o.isSkinnedMesh) o.frustumCulled = false;
+      });
+      for (const name of ['Hips', 'Spine', 'Spine1', 'Head', 'LeftUpLeg', 'LeftLeg',
+        'LeftFoot', 'RightUpLeg', 'RightLeg', 'RightFoot', 'LeftArm', 'LeftForeArm',
+        'RightArm', 'RightForeArm']) {
+        if (!this.bones[name]) throw new Error('Alex animation: missing joint ' + name);
+      }
+      root.updateWorldMatrix(true, true);
+      const inverseRootQ = root.getWorldQuaternion(new Q()).invert();
+      this.feet = ['Left', 'Right'].map((side, i) => {
+        const thigh = this.bones[side + 'UpLeg'], shin = this.bones[side + 'Leg'];
+        const foot = this.bones[side + 'Foot'];
+        const local = bone => root.worldToLocal(bone.getWorldPosition(new V()));
+        const a = local(thigh), b = local(shin), home = local(foot);
+        return { side, offset: i * 0.5, thigh, shin, foot, home,
+          upper: a.distanceTo(b), lower: b.distanceTo(home), hipY: a.y,
+          restQ: inverseRootQ.clone().multiply(foot.getWorldQuaternion(new Q())),
+          anchor: new V(), from: new V(), to: new V(), target: new V(),
+          anchorQ: new Q(), fromQ: new Q(), toQ: new Q(), targetQ: new Q(),
+          swing: false, settling: false, u: 0, plant: 0, initialized: false };
+      });
+      this.reset(root);
+    }
+
+    restore() {
+      for (const b of this.bind) {
+        b.bone.position.copy(b.position);
+        b.bone.quaternion.copy(b.quaternion);
+      }
+    }
+
+    reset(root) {
+      this.root = root;
+      this.restore();
+      this.last = null;
+      this.wasTraveling = false;
+      this.phase = DUTY / 2; // both feet start at the body's center, not at heel strike
+      this.clock = 0;
+      this.move = this.run = this.hipDrop = this.appliedDrop = 0;
+      this.angles = { lean: 0, twist: 0, head: 0, left: 0, right: 0, elbow: 0 };
+      this.direction = new V(1, 0, 0);
+      this.mode = 'idle';
+      this.overlay = null;
+      for (const foot of this.feet) {
+        foot.initialized = false;
+        foot.swing = foot.settling = false;
+        foot.plant++;
+      }
+    }
+
+    // Apply a world-space change to a joint's local quaternion, never the root.
+    turn(bone, axis, angle) {
+      const parentQ = bone.parent.getWorldQuaternion(new Q());
+      const local = parentQ.clone().invert()
+        .multiply(new Q().setFromAxisAngle(axis, angle)).multiply(parentQ);
+      bone.quaternion.premultiply(local).normalize();
+      bone.updateWorldMatrix(false, true);
+    }
+
+    point(bone, child, target) {
+      const origin = bone.getWorldPosition(new V());
+      const from = child.getWorldPosition(new V()).sub(origin).normalize();
+      const to = target.clone().sub(origin).normalize();
+      const worldTurn = new Q().setFromUnitVectors(from, to);
+      const parentQ = bone.parent.getWorldQuaternion(new Q());
+      bone.quaternion.premultiply(parentQ.clone().invert().multiply(worldTurn).multiply(parentQ)).normalize();
+      bone.updateWorldMatrix(false, true);
+    }
+
+    solve(leg, forward) {
+      const hip = leg.thigh.getWorldPosition(new V());
+      const knee = leg.shin.getWorldPosition(new V());
+      const ankle = leg.foot.getWorldPosition(new V());
+      const a = hip.distanceTo(knee), b = knee.distanceTo(ankle);
+      const ray = leg.target.clone().sub(hip), distance = ray.length();
+      const d = clamp(distance, Math.abs(a - b) + 0.0001, a + b - 0.0001);
+      ray.normalize();
+      const along = (a * a + d * d - b * b) / (2 * d);
+      const bend = Math.sqrt(Math.max(0, a * a - along * along));
+      // Knees bend toward Alex's facing, never backwards or at a random pole.
+      const pole = forward.clone().addScaledVector(ray, -forward.dot(ray)).normalize();
+      const targetKnee = hip.clone().addScaledVector(ray, along).addScaledVector(pole, bend);
+      this.point(leg.thigh, leg.shin, targetKnee);
+      this.point(leg.shin, leg.foot, leg.target);
+      leg.foot.quaternion.copy(leg.foot.parent.getWorldQuaternion(new Q()).invert().multiply(leg.targetQ));
+      leg.foot.updateWorldMatrix(false, true);
+    }
+
+    begin(foot, target, rotation, duration, settling, height) {
+      foot.from.copy(foot.target);
+      foot.fromQ.copy(foot.targetQ);
+      foot.to.copy(target);
+      foot.toQ.copy(rotation);
+      foot.swing = true;
+      foot.settling = settling;
+      foot.duration = duration;
+      foot.height = height;
+      foot.u = 0;
+    }
+
+    land(foot) {
+      foot.anchor.copy(foot.to);
+      foot.anchorQ.copy(foot.toQ);
+      foot.target.copy(foot.anchor);
+      foot.targetQ.copy(foot.anchorQ);
+      foot.swing = foot.settling = false;
+      foot.plant++;
+    }
+
+    update(dt, player, pose, fsm) {
+      if (!this.root.visible || !Number.isFinite(dt) || dt <= 0) return;
+      dt = Math.min(dt, 0.1);
+      this.clock += dt;
+      const position = new V(player.x, player.py || 0, player.y);
+      let delta = this.last ? position.clone().sub(this.last) : new V();
+      delta.y = 0;
+      if (delta.length() > 1) { this.reset(this.root); delta.set(0, 0, 0); }
+      const distance = delta.length(), traveling = distance > 0.00001;
+      if (traveling) this.direction.copy(delta).normalize();
+      this.last = position;
+      const base = fsm && fsm.base || player.anim || 'idle';
+      this.mode = traveling ? (base === 'run' || base === 'sprint' ? 'run' : 'walk') : 'idle';
+      this.overlay = fsm && fsm.over ? fsm.over.name : null;
+      this.move = follow(this.move, traveling ? 1 : 0, dt, 0.12);
+      this.run = follow(this.run, this.mode === 'run' ? 1 : 0, dt, 0.08);
+      const stride = 1.30 + 0.45 * this.run;
+      const lift = 0.095 + 0.045 * this.run;
+      const duty = DUTY - 0.12 * this.run;
+      if (traveling) this.phase = (this.phase + distance / stride) % 1;
+      const yaw = player.modelYaw == null ? player.face || 0 : player.modelYaw;
+      const forward = new V(Math.cos(yaw), 0, Math.sin(yaw));
+      const left = new V(Math.sin(yaw), 0, -Math.cos(yaw));
+
+      this.restore();
+      this.root.updateWorldMatrix(true, true);
+      const rootQ = this.root.getWorldQuaternion(new Q());
+      const ahead = stride * duty / 2;
+      const swingTime = 0.23 - 0.03 * this.run;
+      const speed = distance / dt;
+      const starting = traveling && !this.wasTraveling && !this.feet.some(f => f.swing);
+      // Return the trailing foot first after a stop. A restart can continue an
+      // airborne recovery; it must never relabel an airborne target as planted.
+      const recover = !traveling && !this.feet.some(f => f.swing) ? this.feet
+        .filter(f => f.initialized && (f.anchor.distanceTo(this.root.localToWorld(f.home.clone())) > 0.035 ||
+          f.anchorQ.angleTo(rootQ.clone().multiply(f.restQ)) > 0.15))
+        .sort((a, b) => a.anchor.clone().sub(b.anchor).dot(this.direction))[0] : null;
+      for (const f of this.feet) {
+        const home = this.root.localToWorld(f.home.clone());
+        home.y = position.y + f.home.y * this.root.scale.y;
+        const rotation = rootQ.clone().multiply(f.restQ);
+        if (!f.initialized) {
+          f.anchor.copy(home); f.target.copy(home);
+          f.anchorQ.copy(rotation); f.targetQ.copy(rotation); f.initialized = true;
+        }
+        if (traveling) {
+          if (f.swing) f.settling = false;
+          else {
+            const offset = f.anchor.clone().sub(home); offset.y = 0;
+            const firstStep = starting && f.side === 'Right' && offset.length() < 0.08;
+            // Distance, rather than a fixed phase deadline, releases a planted
+            // foot on a sharp turn before the hip-to-ankle reach is exhausted.
+            const needsStep = offset.length() > ahead && offset.dot(this.direction) < ahead * 0.5;
+            if (firstStep || needsStep) {
+              const duration = firstStep ? swingTime * 0.55 : swingTime;
+              const landing = home.clone().addScaledVector(this.direction, speed * duration + ahead);
+              this.begin(f, landing, rotation, duration, false, lift);
+            }
+          }
+        } else {
+          if (f.swing && !f.settling) this.begin(f, home, rotation, 0.22, true, 0.055);
+          if (!f.swing && f === recover) this.begin(f, home, rotation, 0.22, true, 0.055);
+        }
+        if (f.swing) {
+          f.u = Math.min(1, f.u + dt / f.duration);
+          if (traveling) {
+            // Predict the body at touchdown. At constant speed this endpoint
+            // stays fixed in world space; speed/direction changes ease into it.
+            const landing = home.clone().addScaledVector(this.direction,
+              speed * (1 - f.u) * f.duration + ahead);
+            f.to.lerp(landing, 1 - Math.exp(-dt / 0.07));
+            f.toQ.slerp(rotation, 1 - Math.exp(-dt / 0.07));
+          }
+          f.height = follow(f.height, f.settling ? 0.055 : lift, dt, 0.07);
+          if (f.u >= 1) this.land(f);
+          else {
+            const u = ease(f.u);
+            f.target.lerpVectors(f.from, f.to, u);
+            f.target.y += f.height * Math.sin(Math.PI * f.u) ** 2;
+            f.targetQ.slerpQuaternions(f.fromQ, f.toQ, u);
+          }
+        } else { f.target.copy(f.anchor); f.targetQ.copy(f.anchorQ); }
+      }
+      this.wasTraveling = traveling;
+
+      // Lower only the visual pelvis enough for a comfortably bent, reachable
+      // stride. The player's py, root transform and collision radius never change.
+      const leg = this.feet[0], reach = (leg.upper + leg.lower) * 0.96;
+      const strideDrop = Math.max(0, leg.hipY - leg.home.y - Math.sqrt(Math.max(0, reach * reach - ahead * ahead)));
+      this.hipDrop = follow(this.hipDrop, strideDrop * this.move, dt, 0.10);
+      let drop = this.hipDrop;
+      // Reachability also covers turns and stopping midway through a step.
+      for (const f of this.feet) {
+        const hip = f.thigh.getWorldPosition(new V());
+        const horizontal = Math.hypot(f.target.x - hip.x, f.target.z - hip.z);
+        const length = (f.upper + f.lower) * Math.min(1, this.root.scale.y) * 0.97;
+        const maxY = f.target.y + Math.sqrt(Math.max(0, length * length - horizontal * horizontal));
+        drop = Math.max(drop, hip.y - maxY);
+      }
+      // Never approach the straight-knee singularity. Ease the pelvis back up
+      // after a reach constraint clears rather than releasing its offset at once.
+      this.appliedDrop = Math.max(drop, follow(this.appliedDrop, drop, dt, 0.10));
+      drop = Math.max(0, this.appliedDrop);
+      const hips = this.bones.Hips, hipWorld = hips.getWorldPosition(new V());
+      hipWorld.y -= drop;
+      hips.position.copy(hips.parent.worldToLocal(hipWorld));
+      hips.updateWorldMatrix(false, true);
+
+      const a = this.angles, ap = pose || {};
+      a.lean = follow(a.lean, ap.torsoLean || 0, dt, 0.10);
+      a.twist = follow(a.twist, ap.torsoTwist || 0, dt, 0.10);
+      a.head = follow(a.head, ap.headTilt || 0, dt, 0.10);
+      this.turn(this.bones.Spine, left, a.lean * 0.45);
+      this.turn(this.bones.Spine1, left, a.lean * 0.55 + Math.sin(this.clock * 1.6) * 0.008 * (1 - this.move));
+      this.turn(this.bones.Spine1, UP, a.twist);
+      this.turn(this.bones.Head, left, a.head);
+      const arm = Math.cos(this.phase * TAU) * (0.30 + 0.30 * this.run) * this.move;
+      const generic = this.overlay === 'interact' || this.overlay === 'start' || this.overlay === 'stop';
+      a.left = follow(a.left, generic ? ap.armL || 0 : arm, dt, 0.09);
+      a.right = follow(a.right, generic ? ap.armR || 0 : -arm, dt, 0.09);
+      a.elbow = follow(a.elbow, -0.10 - 0.75 * this.run - (this.overlay === 'interact' ? 0.25 : 0), dt, 0.12);
+      this.turn(this.bones.LeftArm, left, a.left);
+      this.turn(this.bones.RightArm, left, a.right);
+      this.turn(this.bones.LeftForeArm, left, a.elbow);
+      this.turn(this.bones.RightForeArm, left, a.elbow);
+      for (const f of this.feet) this.solve(f, forward);
