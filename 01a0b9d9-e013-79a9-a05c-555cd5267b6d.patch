+#!/usr/bin/env python3
+"""Run every canonical Node test against the CURRENT game source (not archived run_*.js).
+Usage: python3 tests/run_current.py [--real-three] [--output DIRECTORY]
+Browser suites are separate: chernobyl/tests/{camera,regression,stability}.js.
+"""
+import argparse
+import json
+import pathlib
+import re
+import subprocess
+import tempfile
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--real-three', action='store_true')
+parser.add_argument('--output')
+args = parser.parse_args()
+root = pathlib.Path(__file__).resolve().parent.parent
+tests = root / 'tests'
+output = pathlib.Path(args.output) if args.output else pathlib.Path(tempfile.mkdtemp(prefix='chernobyl-tests-'))
+output.mkdir(parents=True, exist_ok=True)
+source = re.search(r'<script>([\s\S]*?)</script>', (root / 'chernobyl/index.html').read_text()).group(1)
+harness = (tests / 'harness.js').read_text()
+three = (tests / ('real_three.js' if args.real_three else 'three-stub.js')).read_text()
+results = []
+for test in sorted(tests.glob('t*.js')):
+    if test.name == 'three-stub.js':
+        continue
+    seed = (tests / 'seed_b.js').read_text() if test.name == 't_reopen_b.js' else ''
+    runner = output / ('run_' + test.name)
+    runner.write_text('\n'.join([harness, three, seed, source, test.read_text()]))
+    try:
+        p = subprocess.run(['node', str(runner)], cwd=root, capture_output=True, text=True, timeout=90)
+        log = p.stdout + p.stderr
+        failed = p.returncode != 0 or bool(re.search(r'\bFAIL(?:URES)?\b', log))
+    except subprocess.TimeoutExpired:
+        failed, log = True, 'TIMEOUT: 90 seconds\n'
+    (output / (test.stem + '.log')).write_text(log)
+    results.append({'test': test.name, 'pass': not failed})
+    print(('FAIL ' if failed else 'PASS ') + test.name, flush=True)
+    if failed:
+        print('\n'.join(line for line in log.splitlines() if 'FAIL' in line or 'Error' in line or line.startswith('  - '))[:3000], flush=True)
+p = subprocess.run(['node', str(root / 'chernobyl/tests/t_static.js')], cwd=root, capture_output=True, text=True)
+(output / 't_static.log').write_text(p.stdout + p.stderr)
+results.append({'test': 't_static.js', 'pass': p.returncode == 0})
+print(('PASS ' if p.returncode == 0 else 'FAIL ') + 't_static.js')
+(output / 'results.json').write_text(json.dumps(results, indent=2))
+print('Logs: ' + str(output))
+raise SystemExit(0 if all(r['pass'] for r in results) else 1)
