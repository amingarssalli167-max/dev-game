diff --git a/step3-alex-animation-evidence/capture.js b/step3-alex-animation-evidence/capture.js
new file mode 100644
index 0000000..c07326e
--- /dev/null
+++ b/step3-alex-animation-evidence/capture.js
@@ -0,0 +1,53 @@
+// Alex-only pose inspection under existing scene lighting, plus real game view.
+const fs=require('fs'),puppeteer=require('puppeteer'),chromium=require('@sparticuz/chromium');
+(async()=>{
+ const browser=await puppeteer.launch({executablePath:'/tmp/chromium',headless:true,args:[...(chromium.default||chromium).args,'--enable-unsafe-swiftshader']});
+ try{
+  const page=await browser.newPage();await page.setViewport({width:960,height:540});
+  const errors=[];page.on('pageerror',e=>errors.push(e.message));
+  await page.evaluateOnNewDocument(()=>{requestAnimationFrame=()=>0;setTimeout=()=>0});
+  await page.goto('http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+  await page.evaluate(()=>{startGame(true);closeDlg();G.paused=false;G.time=20;E3.quality=2;applyQuality();update3D(.016)});
+  await page.waitForFunction(()=>AlexVisual.status==='ready',{polling:50});
+  const images=await page.evaluate(()=>{
+   const render=E3.renderer.render.bind(E3.renderer),images=[];
+   E3.renderer.render=scene=>scene.updateMatrixWorld(true);
+   function setup(){
+    enterScene('slice',{x:21.5,y:17.5},{silent:true});closeDlg();IN.aim=0;IN.movedByMouse=true;E3.camSnap=true;
+    Object.assign(G.player,{x:21.5,y:17.5,py:0,vy:0,hidden:false,dead:false,flash:true,modelYaw:0,moveSpeed:0,moving:false,sprint:false,crouch:false,crouchLock:false,injured:0,sta:100,bat:100,stepT:100,hp:3});
+    IN.keys={};ANIM.init(G.player);update3D(1/60);
+   }
+   function step(n,keys){IN.keys=keys;for(let i=0;i<n;i++){G.time+=1/60;updatePlayer(1/60);ANIM.update(1/60,G.player);update3D(1/60)}}
+   function capture(label,game=false){
+    const r=E3.playerRig;
+    const inspect=new THREE.PerspectiveCamera(35,960/540,.05,40);
+    inspect.position.set(r.position.x+2.8,r.position.y+1.15,r.position.z+2.8);
+    inspect.lookAt(r.position.x,r.position.y+.92,r.position.z);
+    render(E3.scene,game?E3.camera:inspect);
+    images.push({label,camera:game?'unchanged game camera':'inspection camera only',animation:AlexVisual.animation,png:E3.renderer.domElement.toDataURL('image/png')});
+   }
+   try{
+    setup();step(45,{});capture('idle');
+    step(4,{KeyW:true});capture('start');step(14,{KeyW:true});capture('walk');capture('walk-game',true);
+    step(5,{KeyW:true});capture('walk-opposite');
+    setup();step(24,{KeyW:true,ShiftLeft:true});capture('run');capture('run-game',true);step(6,{KeyW:true,ShiftLeft:true});capture('run-opposite');
+    step(6,{});capture('stop');step(65,{});capture('settled-idle');
+    ANIM.play('interact');step(18,{});capture('interact');
+   }finally{E3.renderer.render=render;}
+   return images;
+  });
+  for(const i of images)fs.writeFileSync('step3-alex-animation-evidence/'+i.label+'.png',Buffer.from(i.png.split(',')[1],'base64'));
+  const sheet=await page.evaluate(async images=>{
+   const picks=images.filter(i=>!i.label.endsWith('-game'));
+   const canvas=document.createElement('canvas');canvas.width=1440;canvas.height=Math.ceil(picks.length/3)*302;
+   const c=canvas.getContext('2d');c.fillStyle='#10161a';c.fillRect(0,0,canvas.width,canvas.height);
+   for(let n=0;n<picks.length;n++){
+    const i=picks[n],img=new Image();img.src=i.png;await img.decode();const x=n%3*480,y=Math.floor(n/3)*302;
+    c.drawImage(img,x,y+32,480,270);c.fillStyle='#f0f3f4';c.font='16px sans-serif';c.fillText(i.label+' / '+i.animation.mode,x+12,y+22);
+   }return canvas.toDataURL('image/png');
+  },images);
+  fs.writeFileSync('step3-alex-animation-evidence/pose-sheet.png',Buffer.from(sheet.split(',')[1],'base64'));
+  fs.writeFileSync('step3-alex-animation-evidence/capture-metadata.json',JSON.stringify({errors,images:images.map(({png,...i})=>i)},null,2));
+  console.log('Captured',images.length,'frames; errors:',errors);
+ }finally{await browser.close()}
+})().catch(e=>{console.error(e);process.exitCode=1});
diff --git a/step3-alex-animation-evidence/edge-check.js b/step3-alex-animation-evidence/edge-check.js
new file mode 100644
index 0000000..4804ae4
--- /dev/null
+++ b/step3-alex-animation-evidence/edge-check.js
@@ -0,0 +1,58 @@
+// Additional Alex-only edge cases: quick stop/restart and turns. No existing suites.
+const fs=require('fs'),puppeteer=require('puppeteer'),chromium=require('@sparticuz/chromium');
+const OUT='step3-alex-animation-evidence',results=[],errors=[];let data;
+function check(name,pass,detail){results.push({name,pass,detail});console.log((pass?'PASS ':'FAIL ')+name+' '+JSON.stringify(detail));if(!pass)throw Error(name);}
+(async()=>{
+ const browser=await puppeteer.launch({executablePath:'/tmp/chromium',headless:true,args:[...(chromium.default||chromium).args,'--enable-unsafe-swiftshader']});
+ try{
+ const page=await browser.newPage();await page.setViewport({width:640,height:360});
+ page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')errors.push(m.text())});
+ await page.evaluateOnNewDocument(()=>{requestAnimationFrame=()=>0;setTimeout=()=>0;let seed=12345;Math.random=()=>{seed=(Math.imul(seed,1664525)+1013904223)>>>0;return seed/4294967296};});
+ await page.goto('http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+ await page.evaluate(()=>{startGame(true);closeDlg();G.paused=false;G.time=20;E3.quality=0;applyQuality();update3D(.016)});
+ await page.waitForFunction(()=>AlexVisual.status==='ready',{polling:50});
+ data=await page.evaluate(()=>{
+  // Render is omitted only for numerical sampling; the actual controller, FSM,
+  // root/camera update and skeletal skin-vertex transforms still execute.
+  const render=E3.renderer.render;E3.renderer.render=scene=>scene.updateMatrixWorld(true);
+  const out=[];
+  function setup(){
+   enterScene('slice',{x:3.5,y:3.5},{silent:true});closeDlg();IN.aim=0;IN.movedByMouse=true;E3.camSnap=true;
+   Object.assign(G.player,{x:3.5,y:3.5,py:0,vy:0,hidden:false,dead:false,modelYaw:0,moveSpeed:0,moving:false,sprint:false,crouch:false,crouchLock:false,injured:0,sta:100,bat:100,stepT:100,hp:3});
+   IN.keys={};ANIM.init(G.player);update3D(1/60);
+  }
+  try{
+   for(const walkFrames of [1,4,8,12,17,21,26,31,36]){
+    setup();const root=E3.playerRig,shoes=root.userData.alexVisual.getObjectByName('Shoes');
+    const groups={Left:[],Right:[]};for(let i=0;i<shoes.geometry.attributes.position.count;i++){
+     const w=shoes.getVertexPosition(i,new THREE.Vector3()).applyMatrix4(shoes.matrixWorld);
+     if(w.y<.025)groups[root.worldToLocal(w.clone()).x<0?'Left':'Right'].push(i);
+    }
+    let worstContact=0,minSole=Infinity,maxIK=0,maxAngle=0,maxHipStep=0,prev=null;const floating=[],issues=[];
+    const bones=['LeftUpLeg','RightUpLeg','LeftLeg','RightLeg'];
+    for(const [segment,n,keys,aim] of [['walk',walkFrames,{KeyW:true},0],['brief-stop',2,{},0],['restart',45,{KeyW:true},0],['turn',30,{KeyW:true},Math.PI/2],['settle',50,{},Math.PI/2]]){
+     IN.keys=keys;IN.aim=aim;
+     for(let frame=0;frame<n;frame++){
+      G.time+=1/60;updatePlayer(1/60);ANIM.update(1/60,G.player);update3D(1/60);
+      const d=AlexVisual.animation,q=bones.map(n=>root.userData.alexVisual.getObjectByName('mixamorig'+n).quaternion.clone());
+      const hips=root.userData.alexVisual.getObjectByName('mixamorigHips').getWorldPosition(new THREE.Vector3()).y;
+      if(prev && (q.some((v,k)=>v.angleTo(prev.q[k])>.39)||Math.abs(hips-prev.hips)>.05||d.feet.some(f=>f.error>.001)))issues.push({segment,frame,position:root.position.toArray(),debug:d,previous:prev.debug,hips,prevHips:prev.hips,angle:q.map((v,k)=>v.angleTo(prev.q[k]))});
+      if(prev){maxAngle=Math.max(maxAngle,...q.map((v,k)=>v.angleTo(prev.q[k])));maxHipStep=Math.max(maxHipStep,Math.abs(hips-prev.hips));}prev={q,hips,debug:d};
+      for(const foot of d.feet){
+       maxIK=Math.max(maxIK,foot.error);let min=Infinity;
+       for(const i of groups[foot.side])min=Math.min(min,shoes.getVertexPosition(i,new THREE.Vector3()).applyMatrix4(shoes.matrixWorld).y);
+       minSole=Math.min(minSole,min);if(foot.contact){worstContact=Math.max(worstContact,Math.abs(min));if(Math.abs(min)>.025)floating.push({segment,frame,side:foot.side,min});}
+      }
+     }
+    }
+    out.push({issues,walkFrames,worstContact,minSole,maxIK,maxAngle,maxHipStep,floating,rootSame:E3.playerRig===root,feet:AlexVisual.animation.feet});
+   }
+  }finally{E3.renderer.render=render;}
+  return out;
+ });
+ check('Rapid restart and turning: actual contact soles remain grounded',data.every(r=>r.worstContact<=.025&&r.minSole>=-.02&&r.maxIK<.01),data.map(({walkFrames,worstContact,minSole,maxIK,floating})=>({walkFrames,worstContact,minSole,maxIK,floating})));
+ check('Rapid restart and turning: no large joint/pelvis snaps',data.every(r=>r.maxAngle<.4&&r.maxHipStep<.06),data.map(({walkFrames,maxAngle,maxHipStep})=>({walkFrames,maxAngle,maxHipStep})));
+ check('Rapid restart and turning: settle with original root and planted feet',data.every(r=>r.rootSame&&r.feet.every(f=>f.contact)),data.map(({walkFrames,rootSame,feet})=>({walkFrames,rootSame,contacts:feet.map(f=>f.contact)})));
+ check('No runtime/console errors in edge cases',errors.length===0,errors);
+ }finally{await browser.close();fs.writeFileSync(OUT+'/edge-results.json',JSON.stringify({pass:results.filter(r=>r.pass).length,fail:results.filter(r=>!r.pass).length,results,data,errors},null,2))}
+})().catch(e=>{console.error(e);process.exitCode=1});
