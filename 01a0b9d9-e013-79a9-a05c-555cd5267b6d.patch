+ await interact('od_b_apt','apartment');
+ for(const id of ['it_key_bath','it_player','apt_underbed','doc_drawing','apt_bath_door','doc_bath_note'])await interact(id);
+ check('Apartment clues acquired',await page.evaluate(()=>hasItem('tapeplayer')&&hasItem('tape1')&&G.syms.includes('atom')&&hasItem('doc_bath_note')));
+ await exit('outdoor');await interact('od_b_school','school');
+ await page.evaluate(()=>{const n=G.scene.entsLive.find(e=>e.type==='nika');startNikaSchool(n);auditDismiss();});
+ check('Nika dialogue completes and opens Block C',await page.evaluate(()=>G.flags.nikaMet&&G.flags.blockCOpen));
