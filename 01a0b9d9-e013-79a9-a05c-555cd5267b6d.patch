+#!/usr/bin/env node
+// Additional real-WebGL checks; does not replace or alter any existing suite.
+const puppeteer=require('puppeteer'),fs=require('fs');
+(async()=>{
+ const browser=await puppeteer.launch({headless:true,args:[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']});
+ const errors=[],warnings=[];let results=[];
+ try{
+  const page=await browser.newPage();page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')errors.push(m.text());if(m.type()==='warn')warnings.push(m.text());});
+  await page.evaluateOnNewDocument(()=>{window.requestAnimationFrame=()=>0;window.setTimeout=()=>0;});
+  await page.goto(process.env.BASE_URL||'http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+  results=await page.evaluate(()=>{
+   const out=[],check=(name,pass)=>out.push({name,pass:!!pass});
+   for(const [key,preset] of Object.entries(SURFACE)){
+    const m=surfaceMat(key,{color:0x777777});
+    check(key+' uses real Standard material and finite physical coefficients',m.isMeshStandardMaterial&&m.roughness===preset.roughness&&m.metalness===preset.metalness&&m.roughness>=0&&m.roughness<=1&&m.metalness>=0&&m.metalness<=1);m.dispose();
+   }
+   check('material instances and original color textures reused',getMat('concrete')===getMat('concrete')&&getMat('concrete').map===getTex('concrete'));
+   check('cache differentiates same-color wood and metal',solidMat(0x555555,{surface:'wood'})!==solidMat(0x555555,{surface:'paintedMetal'}));
+   check('unchanged character material remains Lambert',solidMat(0x555555).isMeshLambertMaterial);
+   check('screen emissive uses source color plus independent intensity',(()=>{const m=solidMat(SPR3.monitor.screen.c,{surface:'glass',glow:SPR3.monitor.screen.e});return m.emissive.getHex()===SPR3.monitor.screen.c&&m.emissiveIntensity===SPR3.monitor.screen.e;})());
+   startGame(true);closeDlg();E3.quality=2;applyQuality();update3D(1/60);
+   check('six pooled lights, no new point-light shadows',E3.poolLights.length===6&&E3.poolLights.every(l=>!l.castShadow));
+   check('flashlight PCF shadows retained at 1024',E3.flash.castShadow&&E3.flash.shadow.mapSize.width===1024&&E3.renderer.shadowMap.type===THREE.PCFSoftShadowMap);
+   check('Standard shaders compiled without shader error',E3.renderer.info.programs.filter(p=>p.diagnostics).every(p=>p.diagnostics.runnable));
+   return out;
+  });
+  results.push({name:'No runtime or console errors',pass:errors.length===0});
+ }finally{await browser.close();}
+ const summary={pass:results.filter(r=>r.pass).length,fail:results.filter(r=>!r.pass).length,results,errors,warnings};
+ fs.writeFileSync(process.env.OUT||'/tmp/material-check.json',JSON.stringify(summary,null,2));
+ for(const r of results)console.log((r.pass?'PASS ':'FAIL ')+r.name);
+ console.log('MATERIAL CHECK: '+summary.pass+' PASS / '+summary.fail+' FAIL');process.exitCode=summary.fail?1:0;
+})().catch(e=>{console.error(e);process.exitCode=1;});
