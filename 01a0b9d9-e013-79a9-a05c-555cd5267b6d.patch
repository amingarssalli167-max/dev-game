+async function waitFor(page,fn,timeout=9000){
+  const t0=Date.now();let last=null;
+  while(Date.now()-t0<timeout){
+    last=await page.evaluate(fn);
+    if(last)return last;
+    await sleep(300);}
+  return last;}
