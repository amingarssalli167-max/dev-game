+// New Alex-only integration checks. No Step 2 test is edited or replaced.
+const fs=require('fs'),crypto=require('crypto'),puppeteer=require('puppeteer');
+const chromium=require('@sparticuz/chromium');
+const OUT='step3-alex-evidence';
+const before=fs.readFileSync('/home/user/.cache/alex-source/index.before.html','utf8');
+const results=[],errors=[],warnings=[],data={};
+function check(name,pass,detail){results.push({name,pass:!!pass,detail});console.log((pass?'PASS ':'FAIL ')+name+' '+JSON.stringify(detail??''));if(!pass)throw Error(name);}
+(async()=>{
+ const browser=await puppeteer.launch({executablePath:'/tmp/chromium',headless:true,args:[...(chromium.default||chromium).args,'--enable-unsafe-swiftshader']});
+ try{
+  async function open(baseline){
+   const p=await browser.newPage();await p.setViewport({width:1280,height:720});
+   p.on('pageerror',e=>errors.push({baseline,message:e.message}));p.on('console',m=>{if(m.type()==='error')errors.push({baseline,message:m.text()});if(m.type()==='warn')warnings.push(m.text());});p.on('requestfailed',r=>errors.push({baseline,message:r.url()+' '+r.failure()?.errorText}));
+   await p.evaluateOnNewDocument(()=>{requestAnimationFrame=()=>0;setTimeout=()=>0;let seed=19486;Math.random=()=>{seed=(Math.imul(1664525,seed)+1013904223)>>>0;return seed/4294967296;};});
+   if(baseline){await p.setRequestInterception(true);p.on('request',r=>r.isNavigationRequest()?r.respond({status:200,contentType:'text/html',body:before}):r.continue());}
+   await p.goto('http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+   await p.evaluate(()=>{startGame(true);closeDlg();G.paused=false;G.time=20;update3D(.016);window.alexOriginalRoot=E3.playerRig;});
+   if(!baseline)await p.waitForFunction(()=>AlexVisual.status==='ready'||AlexVisual.status==='error',{polling:50,timeout:30000});
+   return p;
+  }
+  // Existing controller/camera, exercised identically before and after the visual import.
+  async function controlTrace(p){
+   const trace={wasd:[],camera:[],collision:[]};
+   await p.evaluate(()=>{enterScene('slice',{x:21.5,y:17.5},{silent:true});closeDlg();E3.quality=1;applyQuality();update3D(.016);});
+   for(const [key,axis,sign] of [['KeyW','x',1],['KeyS','x',-1],['KeyA','y',-1],['KeyD','y',1]]){
+    await p.evaluate(()=>{Object.assign(G.player,{x:21.5,y:17.5,py:0,vy:0,modelYaw:0,hidden:false,dead:false,crouch:false,crouchLock:false,injured:0,stepT:100,sta:100,bat:100});IN.keys={};IN.aim=0;IN.lookX=IN.lookY=0;IN.movedByMouse=true;E3.camSnap=true;G.shakeT=0;update3D(.016);});
+    await p.keyboard.down(key);
+    const r=await p.evaluate(()=>{for(let i=0;i<20;i++){updatePlayer(1/60);update3D(1/60);}return {x:G.player.x-21.5,y:G.player.y-17.5,py:G.player.py,yaw:G.player.modelYaw,camera:E3.camera.position.toArray(),root:E3.playerRig.position.toArray()};});
+    await p.keyboard.up(key);trace.wasd.push({key,axis,sign,...r});
+   }
+   for(const aim of [0,Math.PI/2,Math.PI,3*Math.PI/2]){
+    trace.camera.push(await p.evaluate(aim=>{G.player.x=21.5;G.player.y=17.5;IN.aim=aim;E3.camSnap=true;update3D(.016);const c=E3.camera.position;return {aim,position:c.toArray(),quaternion:E3.camera.quaternion.toArray(),root:E3.playerRig.position.toArray(),rootYaw:E3.playerRig.rotation.y,behind:(c.x-G.player.x)*Math.cos(aim)+(c.z-G.player.y)*Math.sin(aim),solid:solidAt3(c.x,c.z,c.y)};},aim));
+   }
+   trace.collision=await p.evaluate(()=>{
+    const s=G.scene,out=[];
+    for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){
+     let spot=null;
+     outer:for(let y=2;y<s.g.h-2;y++)for(let x=2;x<s.g.w-2;x++)if(!solidAt(s,x+.5,y+.5,.3)&&solidT(getT(s.g,x+dx,y+dy))){spot=[x+.5,y+.5];break outer;}
+     if(!spot)throw Error('No suitable existing wall for collision probe');
+     G.player.x=spot[0];G.player.y=spot[1];
+     for(let i=0;i<80;i++)moveEnt(s,G.player,dx*.05,dy*.05,.30);
+     out.push({direction:[dx,dy],start:spot,end:[G.player.x,G.player.y],distance:Math.hypot(G.player.x-spot[0],G.player.y-spot[1]),solid:solidAt(s,G.player.x,G.player.y,.30)});
+    }
+    return out;
+   });
+   return trace;
+  }
+  const base=await open(true);data.before=await controlTrace(base);await base.close();
+  const page=await open(false);
+  data.model=await page.evaluate(()=>{
+   update3D(.016);const root=E3.playerRig,visual=root.userData.alexVisual,meshes=[],bones=new Set();
+   if(!visual)return {status:AlexVisual.status,error:AlexVisual.error};
+   visual.traverse(o=>{if(o.isBone)bones.add(o.uuid);if(o.isSkinnedMesh){const w=o.geometry.attributes.skinWeight;let good=true;for(let i=0;i<w.count;i++){const sum=w.getX(i)+w.getY(i)+w.getZ(i)+w.getW(i);if(!Number.isFinite(sum)||Math.abs(sum-1)>1e-4)good=false;}meshes.push({name:o.name,triangles:o.geometry.index.count/3,weightsNormalized:good,bones:o.skeleton.bones.length,texture:!!o.material.map,finite:o.geometry.attributes.position.array.every(Number.isFinite)});}});
+   const box=new THREE.Box3().setFromObject(visual,true);const local=box.clone();
+   const raw=visual.children[0];const hips=raw.getObjectByName('mixamorigHips');
+   return {status:AlexVisual.status,error:AlexVisual.error,sameRoot:root===window.alexOriginalRoot,parent:root.parent===E3.world,visualParent:visual.parent===root,rootChildren:root.children.length,visible:root.visible,bones:bones.size,hipsParent:hips.parent.name,animations:raw.animations.length,meshes,root:root.position.toArray(),bounds:{min:box.min.toArray(),max:box.max.toArray()},height:box.max.y-box.min.y,footGap:box.min.y-root.position.y,forward:visual.userData.forward,localRotation:visual.rotation.y,loads:AlexVisual.loads};
+  });
+  check('Model loads locally, full body, all seven skinned meshes',data.model.status==='ready'&&data.model.meshes?.length===7,data.model);
+  check('Existing root identity/attachment preserved; placeholder replaced',data.model.sameRoot&&data.model.parent&&data.model.visualParent&&data.model.rootChildren===1);
+  check('Original humanoid skeleton and skin weights retained; no animation clips',data.model.bones===67&&data.model.animations===0&&data.model.meshes.every(m=>m.bones===67&&m.weightsNormalized&&m.finite&&m.texture));
+  check('Scale 1.82 and sole grounded at unchanged player root',Math.abs(data.model.height-1.82)<1e-4&&Math.abs(data.model.footGap)<1e-4,{height:data.model.height,footGap:data.model.footGap});
+  check('Facing adapted to existing local -Z convention',data.model.localRotation===Math.PI&&JSON.stringify(data.model.forward)==='[0,0,-1]');
+  data.after=await controlTrace(page);
+  for(const r of data.after.wasd)check('Real keyboard '+r.key+' moves through unchanged controller',r[r.axis]*r.sign>.3&&Math.abs(r[r.axis==='x'?'y':'x'])<.1,r);
+  check('Movement and camera trace exactly match pre-import production',JSON.stringify(data.before.wasd)===JSON.stringify(data.after.wasd));
+  for(const r of data.after.camera)check('Behind-view camera follows safely at yaw '+r.aim,r.behind<0&&!r.solid&&r.position.every(Number.isFinite),r);
+  check('All four camera/root transforms exactly match pre-import production',JSON.stringify(data.before.camera)===JSON.stringify(data.after.camera));
+  for(const r of data.after.collision)check('Existing collision stops at wall '+r.direction,r.distance<=.21&&!r.solid,r);
+  check('Collision results exactly match pre-import production',JSON.stringify(data.before.collision)===JSON.stringify(data.after.collision));
+  data.rebuilds=await page.evaluate(()=>{
+   const visual=E3.playerRig.userData.alexVisual,id=visual.uuid,geometryIds=[],materialIds=[],disposed=[];
+   visual.traverse(o=>{if(o.geometry){geometryIds.push(o.geometry.uuid);o.geometry.addEventListener('dispose',()=>disposed.push('geometry'));}if(o.material){materialIds.push(o.material.uuid);o.material.addEventListener('dispose',()=>disposed.push('material'));}});
+   const cases=[];for(const scene of ['outdoor','apartment','slice','outdoor']){enterScene(scene,SCENES[scene].spawn,{silent:true});build3D(true);update3D(.016);const r=E3.playerRig;cases.push({scene,status:r.userData.alexStatus,sameVisual:r.userData.alexVisual?.uuid===id,rootChildren:r.children.length,attached:r.parent===E3.world&&visual.parent===r});}
+   return {cases,disposed,loads:AlexVisual.loads,geometryIds,materialIds};
+  });
+  check('Alex survives scene rebuilds with one cached rig and no premature disposal',data.rebuilds.disposed.length===0&&data.rebuilds.loads===1&&data.rebuilds.cases.every(r=>r.status==='ready'&&r.sameVisual&&r.rootChildren===1&&r.attached),data.rebuilds);
+  // Actual game-camera captures; do not alter renderer, lighting or materials.
+  data.views=[];
+  for(const [name,scene,x,z,aim] of [['outdoor','outdoor',40.5,54.5,-Math.PI/2],['slice','slice',21.5,17.5,0],['interior','apartment',8.5,7.5,-Math.PI/2]]){
+   const view=await page.evaluate(({scene,x,z,aim})=>{enterScene(scene,{x,y:z},{silent:true});IN.aim=aim;E3.pitch=E3.pitchT=.05;E3.camSnap=true;G.player.hidden=false;G.player.dead=false;G.player.py=0;G.player.flash=true;G.shakeT=0;G.paused=true;E3.quality=2;applyQuality();update3D(.016);update3D(.016);const r=E3.playerRig,v=r.userData.alexVisual,box=new THREE.Box3().setFromObject(v,true),center=box.getCenter(new THREE.Vector3()).project(E3.camera),frustum=new THREE.Frustum().setFromProjectionMatrix(new THREE.Matrix4().multiplyMatrices(E3.camera.projectionMatrix,E3.camera.matrixWorldInverse));const visibility=[];v.traverse(o=>{if(o.isMesh)visibility.push(frustum.intersectsObject(o));});return {scene,visible:r.visible,onScreen:visibility.some(Boolean),ndc:center.toArray(),camera:E3.camera.position.toArray(),root:r.position.toArray(),height:box.max.y-box.min.y,footGap:box.min.y-r.position.y,image:E3.renderer.domElement.toDataURL('image/png')};},{scene,x,z,aim});
+   const image=view.image;delete view.image;
+   check('Alex visible and grounded from existing '+name+' camera',view.visible&&view.onScreen&&Math.abs(view.footGap)<1e-4,view);data.views.push(view);
+   fs.writeFileSync(OUT+'/alex-'+name+'.png',Buffer.from(image.split(',')[1],'base64'));
+  }
+  // Front reference under the actual scene lighting, using an inspection camera
+  // only. The production camera and its controller are not modified.
+  const frontImage=await page.evaluate(()=>{enterScene('slice',{x:21.5,y:17.5},{silent:true});IN.aim=0;E3.camSnap=true;update3D(.016);const r=E3.playerRig;const inspect=new THREE.PerspectiveCamera(35,1280/720,.05,40);inspect.position.set(r.position.x+3.1,r.position.y+1.1,r.position.z);inspect.lookAt(r.position.x,r.position.y+.95,r.position.z);E3.renderer.render(E3.scene,inspect);return E3.renderer.domElement.toDataURL('image/png');});
+  fs.writeFileSync(OUT+'/alex-front-inspection.png',Buffer.from(frontImage.split(',')[1],'base64'));
+  check('No runtime, shader, console or failed-request errors',errors.length===0,errors);
+  await page.close();
+ }finally{
+  await browser.close();
+  fs.writeFileSync(OUT+'/targeted-results.json',JSON.stringify({pass:results.filter(r=>r.pass).length,fail:results.filter(r=>!r.pass).length,results,data,errors,warnings:[...new Set(warnings)]},null,2));
+ }
+})().catch(e=>{console.error(e);process.exitCode=1;});
