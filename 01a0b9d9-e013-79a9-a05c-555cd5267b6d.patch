diff --git a/chernobyl/assets/alex/alex-visual.js b/chernobyl/assets/alex/alex-visual.js
new file mode 100644
index 0000000..f4391e3
--- /dev/null
+++ b/chernobyl/assets/alex/alex-visual.js
@@ -0,0 +1,124 @@
+/* Temporary Alex visual only. Gameplay owns the existing E3.playerRig root.
+ * No controller, collision or camera logic lives in this adapter.
+ * Asset provenance and permitted use: NOTICE.md. */
+(function () {
+  'use strict';
+  const modelURL = new URL('remy.glb', document.currentScript.src).href;
+  const state = { model: null, pending: null, root: null, error: null, loads: 0, animator: null };
+
+  function prepare(source) {
+    source.name = 'AlexHumanoid';
+    source.updateMatrixWorld(true);
+
+    // Static import pose, not animation: lower the T-pose arms so they do not
+    // span doorways/the shoulder camera. Original joints and inverse binds stay.
+    for (const [side, sign] of [['Left', 1], ['Right', -1]]) {
+      const arm = source.getObjectByName('mixamorig' + side + 'Arm');
+      const elbow = source.getObjectByName('mixamorig' + side + 'ForeArm');
+      if (!arm || !elbow) throw new Error('Alex: required humanoid arm joint missing');
+      const from = elbow.getWorldPosition(new THREE.Vector3())
+        .sub(arm.getWorldPosition(new THREE.Vector3())).normalize();
+      const to = new THREE.Vector3(sign * 0.12, -1, 0.08).normalize();
+      const turn = new THREE.Quaternion().setFromUnitVectors(from, to);
+      const parent = arm.parent.getWorldQuaternion(new THREE.Quaternion());
+      const localTurn = parent.clone().invert().multiply(turn).multiply(parent);
+      arm.quaternion.premultiply(localTurn).normalize();
+      source.updateMatrixWorld(true);
+    }
+
+    // Fit the imported visual to the existing eye height/root, never vice versa.
+    const bounds = new THREE.Box3().setFromObject(source, true);
+    const height = bounds.max.y - bounds.min.y;
+    if (!Number.isFinite(height) || height <= 0) throw new Error('Alex: invalid model bounds');
+    source.scale.multiplyScalar(1.82 / height);
+    source.updateMatrixWorld(true);
+    const feet = ['Left', 'Right'].map(side =>
+      source.getObjectByName('mixamorig' + side + 'Foot'));
+    if (feet.some(foot => !foot)) throw new Error('Alex: required foot joint missing');
+    const center = feet[0].getWorldPosition(new THREE.Vector3())
+      .add(feet[1].getWorldPosition(new THREE.Vector3())).multiplyScalar(0.5);
+    const fitted = new THREE.Box3().setFromObject(source, true);
+    source.position.set(-center.x, -fitted.min.y, -center.z);
+
+    const visual = new THREE.Group();
+    visual.name = 'AlexVisual';
+    // Existing root yaw is -modelYaw-PI/2, so its authored forward is local -Z.
+    visual.rotation.y = Math.PI;
+    visual.userData.forward = [0, 0, -1];
+    visual.userData.asset = 'Mixamo Remy (temporary Alex base)';
+    visual.add(source);
+    visual.updateMatrixWorld(true);
+    source.traverse(mesh => {
+      if (!mesh.isMesh) return;
+      mesh.castShadow = true;
+      mesh.receiveShadow = true;
+      if (mesh.isSkinnedMesh) {
+        mesh.computeBoundingBox();
+        mesh.computeBoundingSphere();
+      }
+    });
+    return visual;
+  }
+
+  function install(root) {
+    // Replace only the placeholder's visual children; retain the exact root and
+    // its legacy pose references so the existing animation FSM is not rewritten.
+    const oldChildren = root.children.slice();
+    root.add(state.model);
+    for (const child of oldChildren) {
+      if (child === state.model) continue;
+      root.remove(child);
+      child.traverse(mesh => { if (mesh.geometry) mesh.geometry.dispose(); });
+      // Placeholder materials belong to the existing shared MATCACHE, not Alex.
+    }
+    root.userData.alexVisual = state.model;
+    root.userData.alexStatus = 'ready';
+    if (typeof AlexAnimator !== 'undefined') {
+      if (!state.animator) state.animator = new AlexAnimator(state.model, root);
+      else state.animator.reset(root);
+    }
+  }
+
+  function attach(root) {
+    state.root = root;
+    root.userData.alexStatus = state.error ? 'error' : 'loading';
+    if (state.model) {
+      install(root);
+      return;
+    }
+    if (state.pending || state.error) return;
+    state.loads++;
+    state.pending = new AlexGLTFLoader().loadAsync(modelURL)
+      .then(gltf => {
+        state.model = prepare(gltf.scene);
+        // A scene may have rebuilt while the request was pending. Attach only
+        // to the current root; never resurrect an already-disposed world.
+        if (state.root) install(state.root);
+      })
+      .catch(error => {
+        state.error = error.message || String(error);
+        if (state.root) state.root.userData.alexStatus = 'error';
+        console.error('Alex visual could not load:', state.error);
+        // Keep the existing placeholder and controls usable on a genuine failure.
+      });
+  }
+
+  function detach(root) {
+    // Preserve the one player-only asset across the existing world disposal.
+    // Nothing else in the world/resource lifecycle is changed.
+    if (state.root === root) state.root = null;
+    if (root && state.model && state.model.parent === root) root.remove(state.model);
+    if (root) root.userData.alexVisual = null;
+  }
+
+  window.AlexVisual = Object.freeze({
+    attach, detach,
+    update(dt, player, pose, fsm) {
+      if (state.animator && state.root) state.animator.update(dt, player, pose, fsm);
+    },
+    get animation() { return state.animator ? state.animator.debug : null; },
+    get status() { return state.error ? 'error' : state.model ? 'ready' : state.pending ? 'loading' : 'idle'; },
+    get error() { return state.error; },
+    get loads() { return state.loads; }
+  });
+})();
