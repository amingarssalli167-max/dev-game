+    outer:for(let r0=2;r0<6;r0++)for(let a=0;a<12;a++){
+      const x=px+Math.cos(a/12*6.283)*r0,y=py+Math.sin(a/12*6.283)*r0;
+      if(!solidAt3(x,y,0.4)){sx=x;sy=y;break outer;}}
