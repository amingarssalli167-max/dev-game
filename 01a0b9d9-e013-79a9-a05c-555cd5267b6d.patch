+ for(const [key,id,state] of [['Tab','nb','NB'],['KeyI','inv','INVUI']]){
+  await page.keyboard.press(key);check('Open '+id,await page.evaluate(s=>eval(s).open,state));await page.keyboard.press('Escape');check('Close '+id,await page.evaluate(s=>!eval(s).open,state));
+ }
+ const audio=await page.evaluate(async()=>{const a=A.ctx.createAnalyser();a.fftSize=2048;A.master.connect(a);SFX.radio();await new Promise(r=>setTimeout(r,200));const x=new Float32Array(a.fftSize);a.getFloatTimeDomainData(x);A.master.disconnect(a);return {ready:A.ready,state:A.ctx.state,peak:Math.max(...x.map(Math.abs)),finite:x.every(Number.isFinite)};});
