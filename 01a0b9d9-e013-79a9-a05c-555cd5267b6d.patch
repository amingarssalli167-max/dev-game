+        if(hs.length){const h=hs[Math.floor(Math.random()*hs.length)];e.ix=h.x;e.iy=h.y;e.it=6;
+          if(dist(e.x,e.y,h.x,h.y)<14)subtitle('','خطوات تتوقف أمام مكان اعتدت الاختباء فيه.');}
