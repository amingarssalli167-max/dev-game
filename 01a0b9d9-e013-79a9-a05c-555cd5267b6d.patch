+// Alex animation only. Existing suites/assertions are not edited or invoked.
+const fs=require('fs'),puppeteer=require('puppeteer'),chromium=require('@sparticuz/chromium');
+const OUT='step3-alex-animation-evidence',CACHE='/home/user/.cache/alex-animation';
+const results=[],errors=[],warnings=[],data={};
+function check(name,pass,detail){const r={name,pass:!!pass,detail};results.push(r);console.log((pass?'PASS ':'FAIL ')+name+' '+JSON.stringify(detail??''));if(!pass)throw Error(name);}
+(async()=>{
+ const browser=await puppeteer.launch({executablePath:'/tmp/chromium',headless:true,args:[...(chromium.default||chromium).args,'--enable-unsafe-swiftshader']});
+ try{
+  async function open(baseline){
