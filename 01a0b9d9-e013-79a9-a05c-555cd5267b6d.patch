+#!/usr/bin/env node
+// Fixed poses / actual WebGL counters. Does not modify production game logic.
+const fs=require('fs'),path=require('path'),puppeteer=require('puppeteer');
+const OUT=process.env.OUT;if(!OUT)throw Error('OUT required');fs.mkdirSync(OUT,{recursive:true});
+const views=[
+ {name:'street',scene:'outdoor',x:40.5,y:54.5,aim:-Math.PI/2,pitch:.12},
+ {name:'car-front',scene:'slice',x:22,y:19.6,aim:-2.5,pitch:.09},
+ {name:'car-side',scene:'slice',x:18,y:21.8,aim:-Math.PI/2,pitch:.08},
+ {name:'bus',scene:'slice',x:14,y:22,aim:-2.6,pitch:.09},
+ {name:'bench-tree',scene:'slice',x:20,y:28.6,aim:-2.5,pitch:.05},
+ {name:'sign',scene:'slice',x:23,y:27,aim:Math.PI/2,pitch:-.04},
+ {name:'wreck',scene:'outdoor',x:27,y:27,aim:-2.35,pitch:.02},
+ {name:'room',scene:'apartment',x:8.5,y:7.5,aim:-Math.PI/2,pitch:.12}
+];
+(async()=>{
+ const browser=await puppeteer.launch({headless:true,args:[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']});
+ const errors=[],warnings=[],results=[];
+ try{for(const view of views){
+  const page=await browser.newPage();await page.setViewport({width:960,height:540,deviceScaleFactor:1});
+  page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')errors.push(m.text());if(m.type()==='warn')warnings.push(m.text());});page.on('requestfailed',r=>errors.push(r.url()+' '+r.failure()?.errorText));
+  await page.evaluateOnNewDocument(()=>{window.requestAnimationFrame=()=>0;window.setTimeout=()=>0;let seed=19486;Math.random=()=>{seed=(Math.imul(1664525,seed)+1013904223)>>>0;return seed/4294967296;};});
+  if(process.env.SOURCE){await page.setRequestInterception(true);page.on('request',r=>r.isNavigationRequest()?r.respond({status:200,contentType:'text/html',body:fs.readFileSync(process.env.SOURCE,'utf8')}):r.continue());}
+  await page.goto(process.env.BASE_URL||'http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+  const record=await page.evaluate(v=>{
+   startGame(true);closeDlg();G.paused=true;G.time=20;G.dt=1/60;enterScene(v.scene,{x:v.x,y:v.y},{silent:true});
+   IN.aim=v.aim;IN.lookX=IN.lookY=0;IN.movedByMouse=true;E3.pitch=E3.pitchT=v.pitch;E3.camDist=CFG.camDistDefault;E3.camSnap=true;
+   G.player.bat=CFG.batMax;G.player.hidden=false;G.player.flash=true;E3.quality=2;applyQuality();
+   for(let i=0;i<5;i++)update3D(1/60);
+   const R=E3.renderer,gl=R.getContext(),p=new Uint8Array(4),samples=[];
+   for(let i=0;i<7;i++){const t=performance.now();update3D(1/60);gl.readPixels(0,0,1,1,gl.RGBA,gl.UNSIGNED_BYTE,p);samples.push(performance.now()-t);}samples.sort((a,b)=>a-b);
+   const lights=[];E3.scene.traverseVisible(o=>{if(o.isLight&&o.intensity>0)lights.push({type:o.type,shadow:o.castShadow});});
+   const props=E3.sprites.map(r=>({type:r.sp.type,x:r.sp.x,y:r.sp.y,anchor:r.o.position.toArray(),yaw:r.o.rotation.y,visible:r.o.visible,converted:!!r.o.userData.lowPoly,model:r.o.userData.lowPoly||null}));
+   return {view:v,pixelRatio:R.getPixelRatio(),shadowMap:[E3.flash.shadow.mapSize.width,E3.flash.shadow.mapSize.height],activeLights:lights.length,lights,visibleProps:props.filter(p=>p.visible).length,converted:props.filter(p=>p.converted).length,props,render:{calls:R.info.render.calls,triangles:R.info.render.triangles},memory:{...R.info.memory},camera:{position:E3.camera.position.toArray(),quaternion:E3.camera.quaternion.toArray(),fov:E3.camera.fov},synchronizedRenderMs:{median:samples[3],samples},image:R.domElement.toDataURL('image/png'),logical:{grid:Array.from(G.scene.g.d),sprites:G.scene.sprites,lights:G.scene.lights,ints:G.scene.ints,doors:G.scene.doors},gpu:gl.getParameter(gl.getExtension('WEBGL_debug_renderer_info').UNMASKED_RENDERER_WEBGL)};
+  },view);
+  fs.writeFileSync(path.join(OUT,view.name+'.png'),Buffer.from(record.image.split(',')[1],'base64'));delete record.image;
+  results.push(record);console.log(view.name,JSON.stringify({render:record.render,memory:record.memory,lights:record.activeLights,visible:record.visibleProps,converted:record.converted,ms:record.synchronizedRenderMs.median}));await page.close();
+ }}finally{await browser.close();fs.writeFileSync(path.join(OUT,'metrics.json'),JSON.stringify({results,errors,warnings},null,2));}
+ if(errors.length)throw Error(errors.join('\n'));
+})().catch(e=>{console.error(e);process.exitCode=1;});
