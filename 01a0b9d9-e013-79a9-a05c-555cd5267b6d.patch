+suites=[('node',['python3','tests/run_current.py','--output',str(cache/'node')]),('real',['python3','tests/run_current.py','--real-three','--output',str(cache/'real')])]
+suites += [(name,['node','chernobyl/tests/'+name+'.js']) for name in ['regression','camera','keyboard','documents','stability']]
+suites += [('materials',['node','visual-foundation-evidence/material-check.js'])]
+results=[]
+suites=[suites[2]]+suites[:2]+suites[3:]  # Resume with full browser regression first.
+for name,cmd in suites:
+    print('\n=== '+name+' ===',flush=True)
+    env['OUT']=str(out/'material-check.json')
+    p=subprocess.Popen(cmd,cwd=root,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,bufsize=1,start_new_session=True)
+    failed=False
+    with (out/(name+'.log')).open('w') as f:
+        for line in p.stdout:
+            f.write(line);f.flush();print(line,end='',flush=True)
+            if re.match(r'^\s*FAIL\b',line):
+                failed=True;os.killpg(p.pid,signal.SIGTERM);break
+    code=p.wait()
+    results.append(dict(suite=name,pass_=code==0 and not failed,exit=code))
+    (out/'runs.json').write_text(json.dumps(results,indent=2))
+    if failed or code:
+        print('STOP: failure in '+name,flush=True);sys.exit(1)
+    if name in ['node','real']:
+        (out/name).mkdir(exist_ok=True)
+        for f in (cache/name).iterdir():
+            if f.suffix in ['.log','.json']:shutil.copy2(f,out/name/f.name)
