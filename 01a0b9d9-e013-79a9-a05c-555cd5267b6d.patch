+/* ---- NEW generic reusable types (no per-object code needed) ---- */
+/* examine: inspect an object, read a description, optional one-shot reward */
+INTERACT.register('examine',{key:'E',
+  prompt(c){return c.label||'افحص';},
+  run(c){
