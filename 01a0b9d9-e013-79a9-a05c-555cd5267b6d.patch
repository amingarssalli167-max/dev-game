+// Diagnostic only; the existing regression and assertion remain untouched.
+const fs=require('fs'),path=require('path'),puppeteer=require('puppeteer');
+(async()=>{
+ const out=process.env.OUT;fs.mkdirSync(out,{recursive:true});const all=[];
+ const browser=await puppeteer.launch({headless:true,args:[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']});
+ try{for(const [label,source] of [['step1','/home/user/.cache/occlusion-fix/step1.html'],['current',process.env.SOURCE||'chernobyl/index.html']]){
+  const page=await browser.newPage();await page.setViewport({width:1280,height:720});
+  await page.evaluateOnNewDocument(()=>{requestAnimationFrame=()=>0;setTimeout=()=>0;});
+  await page.setRequestInterception(true);page.on('request',r=>r.isNavigationRequest()?r.respond({status:200,contentType:'text/html',body:fs.readFileSync(source,'utf8')}):r.continue());
+  await page.goto('http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+  const data=await page.evaluate(()=>{
+   startGame(true);closeDlg();enterScene('slice',SCENES.slice.spawn,{silent:true});G.paused=true;IN.aim=Math.PI/2;E3.pitch=E3.pitchT=.30;E3.camSnap=true;
+   for(let i=0;i<10;i++)update3D(.016);
+   const identify=o=>{let a=o;while(a){const sp=E3.sprites.find(p=>p.o===a);if(sp)return {type:sp.sp.type,logical:[sp.sp.x,sp.sp.y],anchor:sp.o.position.toArray(),model:sp.o.userData.lowPoly||null};a=a.parent;}return o===E3.world.children[0]?{type:'terrain'}:{type:o.type};};
+   const rc=new THREE.Raycaster(),rays=[];
+   for(let a=0;a<8;a++){
+    const dir=new THREE.Vector3(Math.cos(a*Math.PI/4),0,Math.sin(a*Math.PI/4));
+    rc.set(new THREE.Vector3(G.player.x,1.4,G.player.y),dir);rc.far=40;
+    const hits=rc.intersectObjects(E3.world.children,true),h=hits[0];
+    rays.push({index:a,degrees:a*45,direction:dir.toArray(),pass:!!h&&h.distance>1,hits:hits.slice(0,8).map(h=>({distance:h.distance,point:h.point.toArray(),normal:h.face.normal.toArray(),object:identify(h.object)}))});
+   }
+   const unitBox=typeof PropMeshBuilder!=='undefined'?(()=>{const b=new PropMeshBuilder();b.box(0,0,0,2,2,2,0xffffff);return b.n.map((v,i)=>v*b.p[i]).reduce((a,b)=>a+b,0);})():null;
