+// Actual-world inspection camera only; production camera, geometry and lights unchanged.
+const fs=require('fs'),path=require('path'),puppeteer=require('puppeteer');
+const OUT='step2-final-evidence/angles';fs.mkdirSync(OUT,{recursive:true});
+(async()=>{
+ const browser=await puppeteer.launch({headless:true,args:[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']});
+ const errors=[],warnings=[],records=[];
+ try{
+  const page=await browser.newPage();await page.setViewport({width:600,height:400,deviceScaleFactor:1});
+  page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>{if(m.type()==='error')errors.push(m.text());if(m.type()==='warn')warnings.push(m.text());});
+  await page.evaluateOnNewDocument(()=>{requestAnimationFrame=()=>0;setTimeout=()=>0;});
+  await page.goto('http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+  await page.evaluate(()=>{startGame(true);closeDlg();G.paused=true;G.time=20;E3.quality=2;applyQuality();});
+  for(const scene of ['outdoor','slice']){
+   const props=await page.evaluate(scene=>{enterScene(scene,SCENES[scene].spawn,{silent:true});update3D(.016);return E3.sprites.filter(p=>p.o.userData.lowPoly).map(p=>({type:p.sp.type,x:p.sp.x,y:p.sp.y}));},scene);
+   for(let i=0;i<props.length;i++)for(const [name,angle] of [['front',0],['right',Math.PI/2],['rear',Math.PI],['left',Math.PI*1.5],['oblique',Math.PI/4]]){
+    const record=await page.evaluate(({prop,name,angle})=>{
+     const p=E3.sprites.find(p=>p.sp.type===prop.type&&p.sp.x===prop.x&&p.sp.y===prop.y),box=new THREE.Box3().setFromObject(p.o),center=box.getCenter(new THREE.Vector3()),size=box.getSize(new THREE.Vector3());
+     const distance=Math.max(2.8,size.length()*.95),camera=new THREE.PerspectiveCamera(50,1.5,.04,180);
+     camera.position.set(center.x+Math.sin(angle)*distance,center.y+Math.max(.35,size.y*.13),center.z+Math.cos(angle)*distance);camera.lookAt(center);
+     G.player.x=camera.position.x;G.player.y=camera.position.z;G.player.flash=true;G.player.bat=CFG.batMax;
+     IN.aim=Math.atan2(center.z-G.player.y,center.x-G.player.x);IN.lookX=IN.lookY=0;
+     E3.pitch=E3.pitchT=Math.max(-.5,Math.min(.6,-Math.atan2(center.y-1.45,distance)));E3.camSnap=true;
+     update3D(.016);if(E3.playerRig)E3.playerRig.visible=false; // inspection-only: avoid the avatar hiding the target
+     E3.renderer.render(E3.scene,camera);
+     return {prop,name,camera:camera.position.toArray(),center:center.toArray(),image:E3.renderer.domElement.toDataURL('image/jpeg',.88)};
+    },{prop:props[i],name,angle});
+    const filename=scene+'-'+String(i+1).padStart(2,'0')+'-'+props[i].type+'-'+name+'.jpg';fs.writeFileSync(path.join(OUT,filename),Buffer.from(record.image.split(',')[1],'base64'));delete record.image;records.push({scene,index:i+1,file:filename,...record});
+   }
+   console.log(scene,props.length,'props /',props.length*5,'world-angle captures');
+  }
+  // Close-ups of independently found contacts, at their unchanged world positions.
+  for(const [name,eye,target] of [['lamp-transformer',[91.4,2.4,67.3],[93,1.0,65]],['lamp-wheel',[28.2,1.8,53],[31,1.15,50.95]]]){
+   const image=await page.evaluate(({eye,target})=>{
+    enterScene('outdoor',SCENES.outdoor.spawn,{silent:true});G.player.x=eye[0];G.player.y=eye[2];G.player.flash=true;G.player.bat=CFG.batMax;IN.aim=Math.atan2(target[2]-eye[2],target[0]-eye[0]);E3.pitch=E3.pitchT=.05;update3D(.016);if(E3.playerRig)E3.playerRig.visible=false;
+    const c=new THREE.PerspectiveCamera(45,1.5,.04,100);c.position.fromArray(eye);c.lookAt(new THREE.Vector3(...target));E3.renderer.render(E3.scene,c);return E3.renderer.domElement.toDataURL('image/png');
+   },{eye,target});fs.writeFileSync(path.join(OUT,name+'.png'),Buffer.from(image.split(',')[1],'base64'));
+  }
+ }finally{await browser.close();fs.writeFileSync(path.join(OUT,'manifest.json'),JSON.stringify({records,errors,warnings},null,2));}
+ if(errors.length)throw Error(errors.join('\n'));
+})().catch(e=>{console.error(e);process.exitCode=1;});
