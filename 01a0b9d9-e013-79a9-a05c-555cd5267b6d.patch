+#!/usr/bin/env node
+/* Targeted browser regression for the two missing DOCS definitions.
+ * Uses the existing scene builders, revisit hook, focus system, E key,
+ * notebook and save/load. No game system is patched by this test.
+ */
+const puppeteer=require('puppeteer');
+const fs=require('fs'),path=require('path');
+const OUT=process.env.DOCUMENT_TEST_OUTPUT||'/tmp/chernobyl-documents';
+fs.mkdirSync(OUT,{recursive:true});
+const sleep=ms=>new Promise(r=>setTimeout(r,ms));
+const results=[],errors=[],warnings=[];
+function check(name,pass,detail){results.push({name,pass:!!pass,detail});console.log((pass?'PASS ':'FAIL ')+name+(detail?' '+JSON.stringify(detail):''));}
+(async()=>{
+ const args=process.env.CHROMIUM_SERVERLESS?[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']:['--no-sandbox','--use-gl=angle','--use-angle=swiftshader','--enable-unsafe-swiftshader'];
+ const browser=await puppeteer.launch({headless:true,args});
+ try{
+  for(const [key,scene,id] of [['extra_photo','apartment','doc_extra_photo'],['kinder_note','kindergarten','doc_kinder_note']]){
+   const page=await browser.newPage();await page.setViewport({width:960,height:540});
+   page.on('pageerror',e=>errors.push(e.message));
+   page.on('console',m=>{if(m.type()==='error')errors.push(m.text());if(m.type()==='warn')warnings.push(m.text());});
+   page.on('requestfailed',r=>errors.push(r.url()+' '+r.failure()?.errorText));
+   await page.goto(process.env.BASE_URL||'http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+   await page.evaluate(()=>localStorage.clear());await page.click('#btnNew');await sleep(6500);
+   const setup=await page.evaluate(({key,scene,id})=>{
+    // Advance only the already-open introduction. Do not replace story callbacks.
+    while(DLG.open){const l=DLG.q[DLG.i];if(l?.opts){l.opts[0].f?.();DLG.i++;showLine();}else nextLine();}
+    E3.quality=0;applyQuality();enterScene(scene,SCENES[scene].spawn,{silent:true});
+    const firstVisit=G.scene.ints.filter(i=>i.id===id).length;
+    if(key==='extra_photo'){
+     enterScene('outdoor',SCENES.outdoor.spawn,{silent:true});
+     enterScene(scene,SCENES[scene].spawn,{silent:true});
+    }
+    const d=DOCS[key];
+    return {firstVisit,count:G.scene.ints.filter(i=>i.id===id).length,visits:G.visits[scene],
+      definition:!!d&&['kind','title','body'].every(k=>typeof d[k]==='string'&&d[k].trim().length>0)};
+   },{key,scene,id});
+   check(key+' definition has kind/title/body',setup.definition,setup);
+   check(key+' original placement/revisit unchanged',setup.count===1&&(key!=='extra_photo'||setup.firstVisit===0&&setup.visits===2));
+   const focused=await page.evaluate(id=>{
+    const s=G.scene;
+    const reach=()=>{const q=[],seen=new Set();const push=(x,y)=>{const i=y*s.w+x;if(x<0||y<0||x>=s.w||y>=s.h||seen.has(i)||solidAt(s,x+.5,y+.5,.3))return;seen.add(i);q.push(i);};
+     push(Math.floor(G.player.x),Math.floor(G.player.y));
+     for(let k=0;k<q.length;k++){const i=q[k],x=i%s.w,y=Math.floor(i/s.w);push(x+1,y);push(x-1,y);push(x,y+1);push(x,y-1);}return q;};
+    const focus=c=>{if(!c)return false;const ox=G.player.x,oy=G.player.y;
+     for(const i of reach()){const x=i%s.w+.5,y=Math.floor(i/s.w)+.5;if(Math.hypot(x-c.x,y-c.y)>INTERACT.range)continue;
+      G.player.x=x;G.player.y=y;IN.aim=Math.atan2(c.y-y,c.x-x);updateHint();if(curInt?.id===c.id)return true;G.player.x=ox;G.player.y=oy;}return false;};
+    for(let n=0;n<50;n++){
+     if(focus(s.ints.find(i=>i.id===id)))return true;
+     let opened=false;for(const d of s.ints.filter(i=>i.type==='door'&&!i.to&&!i.used&&!i.locked))if(focus(d)){doInteract();opened=true;break;}
+     if(!opened)return false;
+    }return false;
+   },id);
+   check(key+' reachable / focused through existing doors',focused);
+   const before=await page.evaluate(()=>G.stats.docs);
+   await page.keyboard.press('KeyE');await sleep(120);
+   const read=await page.evaluate(({key,id})=>({
+    open:DOC.open&&!$('doc').classList.contains('hide'),
+    title:$('docTitle').textContent,body:$('docBody').textContent,
+    matches:!!DOCS[key]&&$('docTitle').textContent===DOCS[key].title&&$('docBody').textContent===DOCS[key].body,
+    listed:G.docs.filter(k=>k==='doc_'+key).length,inventory:!!G.items['doc_'+key],
+    used:G.scene.ints.find(i=>i.id===id).used,stats:G.stats.docs
+   }),{key,id});
+   check(key+' E opens correct nonempty document',read.open&&read.matches&&read.body.length>0,read);
+   check(key+' collection recorded exactly once',read.listed===1&&read.inventory&&read.used&&read.stats===before+1);
+   if(read.open)await page.screenshot({path:path.join(OUT,key+'.png')});
+   await page.keyboard.press('Escape');
+   await page.keyboard.press('Tab');await page.click('#nbTabs [data-t="files"]');
+   const entry=await page.evaluate(key=>{const d=DOCS[key];if(!d)return false;return [...$('nbBody').querySelectorAll('.entry')].some(e=>e.textContent.includes(d.title));},key);
+   check(key+' visible in notebook',entry);
+   if(entry)await page.evaluate(key=>{[...$('nbBody').querySelectorAll('.entry')].find(e=>e.textContent.includes(DOCS[key].title)).click();},key);
+   check(key+' notebook reopens same text without duplicate',await page.evaluate(key=>!!DOCS[key]&&DOC.open&&$('docBody').textContent===DOCS[key].body&&G.docs.filter(k=>k==='doc_'+key).length===1,key));
+   await page.evaluate(()=>{closeDoc();closeNb();saveGame(false,'1');});
+   await page.reload({waitUntil:'domcontentloaded'});await page.click('#btnCont');await sleep(200);
+   check(key+' persists after reload / Continue',await page.evaluate(key=>G.docs.filter(k=>k==='doc_'+key).length===1&&!!G.items['doc_'+key],key));
+   await page.keyboard.press('Tab');await page.click('#nbTabs [data-t="files"]');
+   const reopened=await page.evaluate(key=>{const d=DOCS[key];if(!d)return false;const e=[...$('nbBody').querySelectorAll('.entry')].find(e=>e.textContent.includes(d.title));if(!e)return false;e.click();return DOC.open&&$('docBody').textContent===d.body;},key);
+   check(key+' readable from notebook after reload',reopened);
+   await page.close();
+  }
+  check('Console errors / request failures',errors.length===0,errors);
+ }finally{
+  await browser.close();const pass=results.filter(r=>r.pass).length,fail=results.length-pass;
+  fs.writeFileSync(path.join(OUT,'results.json'),JSON.stringify({pass,fail,results,errors,warnings},null,2));
+  console.log('DOCUMENTS: PASS '+pass+' / FAIL '+fail);process.exitCode=fail?1:0;
+ }
+})().catch(e=>{console.error(e);process.exitCode=1;});
