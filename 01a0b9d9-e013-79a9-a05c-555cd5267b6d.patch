+  act(e,ai,s,P,dt){AI.moveTo(e,ai,s,ai.ix,ai.iy,AI.speed(ai,'investigate'),dt);}});
+
+AI.state({name:'search',
+  enter(e,ai){ai.searchT=(ai.arch.search&&ai.arch.search.time)||6;ai.searchPts=AI.searchPoints(e,ai);ai.sIdx=0;},
