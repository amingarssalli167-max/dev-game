+#!/usr/bin/env node
+// Isolated WASD test: don't mix keyboard assertions with delayed story dialogue.
+const puppeteer=require('puppeteer');
+const sleep=ms=>new Promise(r=>setTimeout(r,ms));
+(async()=>{
+ const args=process.env.CHROMIUM_SERVERLESS?[...require('@sparticuz/chromium').default.args,'--enable-unsafe-swiftshader']:['--no-sandbox','--use-gl=angle','--use-angle=swiftshader','--enable-unsafe-swiftshader'];
+ const browser=await puppeteer.launch({headless:true,args});let fail=0;const errors=[];
+ try{
+  const page=await browser.newPage();page.on('pageerror',e=>errors.push(e.message));
+  await page.goto(process.env.BASE_URL||'http://127.0.0.1:8000/index.html',{waitUntil:'domcontentloaded'});
+  await page.click('#btnNew');await sleep(7000);
+  await page.evaluate(()=>{closeDlg();enterScene('slice',{x:21.5,y:17.5},{silent:true});E3.quality=0;applyQuality();});
+  for(const [key,axis,sign] of [['KeyW','x',1],['KeyS','x',-1],['KeyA','y',-1],['KeyD','y',1]]){
+   await page.evaluate(()=>{G.player.x=21.5;G.player.y=17.5;IN.aim=0;IN.lookX=IN.lookY=0;IN.movedByMouse=true;IN.keys={};});
+   await page.keyboard.down(key);
+   try{await page.waitForFunction(()=>Math.hypot(G.player.x-21.5,G.player.y-17.5)>.3,{timeout:10000});}
+   finally{await page.keyboard.up(key);}
+   const d=await page.evaluate(()=>({x:G.player.x-21.5,y:G.player.y-17.5}));
+   const ok=d[axis]*sign>.3&&Math.abs(d[axis==='x'?'y':'x'])<.1;if(!ok)fail++;
+   console.log((ok?'PASS ':'FAIL ')+key+' '+JSON.stringify(d));
+  }
+  if(errors.length){fail++;console.log('FAIL console',errors);}
+ }finally{await browser.close();}
+ console.log('KEYBOARD: '+(fail?'FAIL '+fail:'PASS'));process.exitCode=fail?1:0;
+})().catch(e=>{console.error(e);process.exitCode=1;});
diff --git a/chernobyl/tests/regression.js b/chernobyl/tests/regression.js
