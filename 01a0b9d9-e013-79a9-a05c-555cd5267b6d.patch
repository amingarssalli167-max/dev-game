+ await page.evaluate(()=>{
+  window.auditReach=()=>{const s=G.scene,W=s.w,H=s.h,seen=new Uint8Array(W*H),q=[];
+   const push=(x,y)=>{if(x<0||y<0||x>=W||y>=H)return;const i=y*W+x;if(seen[i]||solidAt(s,x+.5,y+.5,.30))return;seen[i]=1;q.push(i);};
+   push(Math.floor(G.player.x),Math.floor(G.player.y));
+   for(let k=0;k<q.length;k++){const i=q[k],x=i%W,y=(i/W)|0;push(x-1,y);push(x+1,y);push(x,y-1);push(x,y+1);}return q;
