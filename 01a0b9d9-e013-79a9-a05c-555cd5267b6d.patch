+
+AI.state({name:'investigate',
+  enter(e,ai){const lk=ai.lastKnown;ai.ix=lk?lk.x+(Math.random()-0.5)*1.5:e.x;ai.iy=lk?lk.y+(Math.random()-0.5)*1.5:e.y;
